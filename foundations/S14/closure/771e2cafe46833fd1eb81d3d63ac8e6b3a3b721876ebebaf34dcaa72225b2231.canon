
artifactsource
source
pathlanguages/json/json.grammar
text˜grammar "json"
start value

token string str "\"[^\"]*\""
token number str "-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?"

category value
  prod EmptyObject "{" "}"
  prod Object "{" members : members "}"
  prod EmptyArray "[" "]"
  prod Array "[" elements : elements "]"
  prod String value : string
  prod Number value : number
  prod True "true"
  prod False "false"
  prod Null "null"

category members
  prod MoreMembers value : member "," rest : members
  prod LastMember value : member

category member
  prod Member key : string ":" value : value

category elements
  prod MoreElements value : value "," rest : elements
  prod LastElement value : value
