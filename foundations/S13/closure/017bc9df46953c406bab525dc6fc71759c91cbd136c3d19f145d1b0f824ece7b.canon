
artifactsource
source
pathlanguages/scala/scala.grammar
text�?grammar "scala"
start document

token layout sym "x"
token linecomment str "//[^\\r\\n]*\\r?\\n?"
token blockcomment str "/\\*([^*]|\\*+[^*/])*\\*+/"
token triplequoted str "(\"\"\"([^\"]|\"[^\"]|\"\"[^\"])*\"\"\"\"|\"\"\"([^\"]|\"[^\"]|\"\"[^\"])*\"\"\")"
token triplesinglequoted str "('''''([^']|'[^']|''[^']|'''[^']|''''[^'])*'''''|''''([^']|'[^']|''[^']|'''[^'])*''''|'''([^']|'[^']|''[^'])*''')"
token dquoted str "\"(\\$\\{[^{}]*\\}|\\$[A-Za-z_][A-Za-z0-9_]*|\\$|\\\\.|[^\"\\\\$\\r\\n])*\""
token squotedtext str "'(\\.|[^'\\\r\n])+'"
token charlit str "'(\\\\(u[0-9a-fA-F]{4}|.)|[^'\\\\])'"
token number str "(0x[0-9a-fA-F]+|[0-9]+(\\.[0-9]+)?)[a-zA-Z]*"
token backquoted str "`[^`\\r\\n]+`"
token word str "[A-Za-z_À-ÿァ-ヿ一-龯А-Яа-яЁёΑ-ω][A-Za-z0-9_À-ÿァ-ヿ一-龯А-Яа-яЁёΑ-ω]*"
token operator str "[-!#%&*+/<=>?@^|~\\\\⇒→]+"
token slashcolon sym "/:"
token colonbackslash sym ":\\\\"
token underscore sym "_"
token newline sym "\\n"

category document
  fold ScalaDocument item

category item
  prod Brace "{" body : document "}"
  prod EmptyBrace "{" "}"
  prod ObjectBraced "object" name : word "{" body : document "}"
  prod ObjectHeaderBraced "object" name : word header : headerDocument "{" body : document "}"
  prod ObjectColon "object" name : word ":" newline : newline "INDENT" body : document "DEDENT"
  prod ObjectHeaderColon "object" name : word header : headerDocument ":" newline : newline "INDENT" body : document "DEDENT"
  prod TraitBraced "trait" name : word "{" body : document "}"
  prod TraitHeaderBraced "trait" name : word header : headerDocument "{" body : document "}"
  prod TraitColon "trait" name : word ":" newline : newline "INDENT" body : document "DEDENT"
  prod TraitHeaderColon "trait" name : word header : headerDocument ":" newline : newline "INDENT" body : document "DEDENT"
  prod ClassHeaderIndentedBraced "class" name : word params : headerInline heritageLead : headerIndented "{" body : document "}"
  prod ClassHeaderIndentedIndentBraced "class" name : word params : headerInline heritageLead : headerIndented "{" "INDENT" body : document "}"
  prod ClassHeaderIndentedBodyBraced "class" name : word params : headerInline heritageLead : headerIndented "{" newline : newline "INDENT" body : document "}"
  prod ClassHeaderIndentedDedentBraced "class" name : word params : headerInline heritageLead : headerIndented "{" body : document "DEDENT" "}"
  prod ClassHeaderIndentedIndentDedentBraced "class" name : word params : headerInline heritageLead : headerIndented "{" "INDENT" body : document "DEDENT" "}"
  prod ClassHeaderIndentedBodyDedentBraced "class" name : word params : headerInline heritageLead : headerIndented "{" newline : newline "INDENT" body : document "DEDENT" "}"
  prod ClassHeaderBraced "class" name : word header : headerDocument "{" body : document "}"
  prod ClassHeaderIndentBraced "class" name : word header : headerDocument "{" "INDENT" body : document "}"
  prod ClassHeaderBodyBraced "class" name : word header : headerDocument "{" newline : newline "INDENT" body : document "}"
  prod ClassHeaderDedentBraced "class" name : word header : headerDocument "{" body : document "DEDENT" "}"
  prod ClassHeaderIndentDedentBraced "class" name : word header : headerDocument "{" "INDENT" body : document "DEDENT" "}"
  prod ClassHeaderBodyDedentBraced "class" name : word header : headerDocument "{" newline : newline "INDENT" body : document "DEDENT" "}"
  prod ClassBraced "class" name : word "{" body : document "}"
  prod ClassIndentBraced "class" name : word "{" "INDENT" body : document "}"
  prod ClassBodyBraced "class" name : word "{" newline : newline "INDENT" body : document "}"
  prod ClassDedentBraced "class" name : word "{" body : document "DEDENT" "}"
  prod ClassIndentDedentBraced "class" name : word "{" "INDENT" body : document "DEDENT" "}"
  prod ClassBodyDedentBraced "class" name : word "{" newline : newline "INDENT" body : document "DEDENT" "}"
  prod ClassHeaderColon "class" name : word header : headerDocument ":" newline : newline "INDENT" body : document "DEDENT"
  prod ClassColon "class" name : word ":" newline : newline "INDENT" body : document "DEDENT"
  prod DefOperator "def" name : operator
  prod InlineDefSplice "inline" "def" name : word header : headerDocumentTyped "=" "$" "{" body : document "}"
  prod DefQuoted "def" name : word header : headerDocumentTyped "=" "'" "{" body : document "}"
  prod BlockColon header : headerDocument ":" newline : newline "INDENT" body : document "DEDENT"
  prod BlockColonBare ":" newline : newline "INDENT" body : document "DEDENT"
  prod BlockEquals header : headerDocumentTyped "=" newline : newline "INDENT" body : document "DEDENT"
  prod BlockEqualsBare "=" newline : newline "INDENT" body : document "DEDENT"
  prod BlockArrow header : headerDocumentTyped "=>" newline : newline "INDENT" body : document "DEDENT"
  prod BlockThen header : headerDocumentTyped "then" newline : newline "INDENT" body : document "DEDENT"
  prod BlockElse "else" newline : newline "INDENT" body : document "DEDENT"
  prod BlockDo header : headerDocumentTyped "do" newline : newline "INDENT" body : document "DEDENT"
  prod IndentBlock "INDENT" body : document "DEDENT"
  pass itemCore

category itemCore
  prod IndentToken "INDENT"
  prod DedentToken "DEDENT"
  prod Colon ":"
  prod Assign "="
  prod FatArrow "=>"
  prod ThenKw "then"
  prod ElseKw "else"
  prod DoKw "do"
  prod Newline value : newline
  pass itemCoreNoColon

category itemCoreNoColon
  prod ParenLayout "(" "INDENT" body : document "DEDENT" ")"
  prod ParenIndented "(" newline : newline "INDENT" body : document "DEDENT" ")"
  prod Paren "(" body : document ")"
  prod EmptyParen "(" ")"
  prod Bracket "[" body : document "]"
  prod EmptyBracket "[" "]"
  prod LineComment value : linecomment
  prod BlockComment value : blockcomment
  prod TripleQuoted value : triplequoted
  prod TripleSingleQuoted value : triplesinglequoted
  prod DQuoted value : dquoted
  prod SQuotedText value : squotedtext
  prod Splice "$" "{" body : document "}"
  prod Quoted "'" "{" body : document "}"
  prod CharLit value : charlit
  prod Number value : number
  prod Abstract "abstract"
  prod CaseKw "case"
  prod Catch "catch"
  prod ClassKw "class"
  prod Def "def"
  prod Enum "enum"
  prod Extends "extends"
  prod Export "export"
  prod Extension "extension"
  prod False "false"
  prod Final "final"
  prod Finally "finally"
  prod For "for"
  prod Given "given"
  prod If "if"
  prod Implicit "implicit"
  prod Import "import"
  prod Inline "inline"
  prod Lazy "lazy"
  prod Match "match"
  prod New "new"
  prod NullKw "null"
  prod ObjectKw "object"
  prod Opaque "opaque"
  prod Override "override"
  prod Package "package"
  prod Private "private"
  prod Protected "protected"
  prod Return "return"
  prod Sealed "sealed"
  prod SelfKw "this"
  prod SuperKw "super"
  prod Throw "throw"
  prod Trait "trait"
  prod True "true"
  prod Try "try"
  prod TypeKw "type"
  prod Using "using"
  prod Val "val"
  prod Var "var"
  prod While "while"
  prod With "with"
  prod Yield "yield"
  prod EndKw "end"
  prod Comma ","
  prod Semicolon ";"
  prod Dot "."
  prod Dollar "$"
  prod Backquoted value : backquoted
  prod SlashColon value : slashcolon
  prod ColonBackslash value : colonbackslash
  prod Operator value : operator
  prod Underscore value : underscore
  prod Word value : word

category headerDocument
  fold HeaderDocument headerItem

category headerItem
  prod HeaderIndent "INDENT"
  prod HeaderDedent "DEDENT"
  prod HeaderNewline value : newline
  pass itemCoreNoColon

category headerInline
  fold HeaderInline headerInlineItem

category headerInlineItem
  pass itemCoreNoColon

category headerIndented
  fold HeaderIndented headerIndentedItem

category headerIndentedItem
  prod HeaderIndentedNewline value : newline
  prod HeaderIndentedIndent "INDENT"
  pass itemCoreNoColon

category itemCoreWithColon
  prod TypedColon ":"
  pass itemCoreNoColon

category headerDocumentTyped
  fold HeaderDocumentTyped headerItemTyped

category headerItemTyped
  pass itemCoreWithColon
