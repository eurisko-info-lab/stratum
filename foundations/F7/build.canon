; F7: a signed publication ledger with one designated authority.
(build
  (name "F7")
  (bootstrap "StratumHost0/1")
  (predecessor (dir "foundations/F6"))
  (change (file "changes/F6-F7/change.canon"))
  (application
    (application
      (name "stratum-f7")
      (host (file "host/core.canon"))
      (meta (program-of [
        (file "languages/meta/prelude.meta")
        (file "languages/meta/source.meta")
        (file "languages/meta/elaborate.meta")
        (file "languages/grammar/elaborate.meta")
        (file "languages/foundation/foundation.meta")
        (file "languages/foundation/derive.meta")
        (file "languages/foundation/delta.meta")
        (file "languages/lambda/lambda.generated.meta")
        (file "features/change/change.generated.meta")
        (file "features/repository/repository.generated.meta")
        (file "features/repository/scenarios.generated.meta")
        (file "features/tooling/tooling.generated.meta")
        (file "features/governance/governance.generated.meta")
        (file "features/governance/scenarios.generated.meta")
        (file "features/foundation/foundation.generated.meta")
        (file "features/ledger/ledger.generated.meta")
      ]))
      (grammars {
        lambda (file "languages/lambda/lambda.generated.grammar")
        meta (file "languages/meta/meta.generated.grammar")
        grammar (file "languages/grammar/grammar.generated.grammar")
      })
      (entries {})
      (checks (include "fixtures/ledger/f7-checks.canon"))
      (kernel (kernel (allow cas-get cas-has hash grammar-parse grammar-print sign verify public-key)))
      (resources (budget (steps 20000000) (depth 20000))))))
