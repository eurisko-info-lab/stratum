              (pv bound))
            (call
              Eval
              (v decls)
              (v bound)
              (v body)))
          (case
            (pm none)
            (call
              MatchCases
              (v decls)
              (v env)
              (v value)
              (v rest)))))
      (case
        (pcons
          (pv head)
          (pv rest))
        (call
          MatchCases
          (v decls)
          (v env)
          (v value)
          (v rest)))))
  (judgment
    MatchPattern
    [decls pattern value env]
    (match
      (v pattern)
      (case
        (pm PatWild)
        (mk
          some
          (v env)))
      (case
        (pm
          PatVar
          (pv name))
        (match
          (call
            FindConstructor
            (v decls)
            (v name))
          (case
            (pm
              some
              (pm
                constructor
                (pv declared)
                (pv arity)))
            (call
              MatchTag
              (v declared)
              (v value)
              (v env)))
          (case
            (pm none)
            (mk
              some
              (prim
                cons
                (mk
                  bind
                  (v name)
                  (v value))
                (v env))))))
      (case
        (pm
          PatApply
          (pv left)
          (pv right))
        (call
          MatchSpine
          (v decls)
          (call
            PatternSpine
            (v pattern))
          (v value)
          (v env)))
      (case
        _
        (mk none))))
  (judgment
    MatchTag
    [declared value env]
    (if
      (prim
        is-node
        (v value))
      (if
        (prim
          eq
          (prim
            tag
            (v value))
          (v declared))
        (mk
          some
          (v env))
        (mk none))
      (mk none)))
  (judgment
    PatternSpine
    [node]
    (match
      (v node)
      (case
        (pm
          PatApply
          (pv left)
          (pv right))
        (prim
          snoc
          (call
            PatternSpine
            (v left))
          (v right)))
      (case
        _
        (lst
          (v node)))))
  (judgment
    MatchSpine
    [decls parts value env]
    (match
      (v parts)
      (case
        (pcons
          (pm
            PatVar
            (pv declared))
          (pv subs))
        (if
          (prim
            is-node
            (v value))
          (if
            (prim
              eq
              (prim
                tag
                (v value))
              (v declared))
            (call
              MatchArguments
              (v decls)
              (v subs)
              (prim
                args
                (v value))
              (v env))
            (mk none))
          (mk none)))
      (case
        _
        (mk none))))
  (judgment
    MatchArguments
    [decls subs args env]
    (match
      (v subs)
      (case
        (pnil)
        (mk
          some
          (v env)))
      (case
        (pcons
          (pv pattern)
          (pv rest))
        (match
          (v args)
          (case
            (pnil)
            (mk none))
          (case
            (pcons
              (pv argument)
              (pv remaining))
