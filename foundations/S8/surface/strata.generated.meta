              (call
                MatchPattern
                (v decls)
                (v pattern)
                (v argument)
                (v env))
              (case
                (pm
                  some
                  (pv bound))
                (call
                  MatchArguments
                  (v decls)
                  (v rest)
                  (v remaining)
                  (v bound)))
              (case
                (pm none)
                (mk none))))))))
  (judgment
    EvalExample
    [grammar source]
    (let
      parsed
      (call
        ParseStrata
        (v grammar)
        (v source))
      (call
        EvalName
        (call
          Declarations
          (v parsed))
        (lst)
        (q example)))))
