; S5: the self-hosting compiler, and the sixth foundation of the second floor.
;
; Strata has no primitives: data, definitions, application, `let` and `match`,
; and nothing else. That is what makes a compiler for it writable in it, and
; also what stops that compiler resolving its own names -- there is no
; equality to compare two names with. So the compiler takes a resolved core,
; the reader produces one, and the machine runs what the compiler emits.
;
; The layer is accepted when the compiler's own source, compiled by the
; reference evaluator and then run on that same source, produces itself.
(build
  (name "S5")
  (bootstrap "StratumHost0/1")
  (predecessor (dir "foundations/S4"))
  (change (file "changes/S4-S5/change.canon"))
  (application
    (application
      (name "strata-s5")
      (host (file "host/core.canon"))
      (meta (program-of [
        (file "languages/meta/prelude.meta")
        (file "languages/meta/source.meta")
        (file "languages/meta/elaborate.meta")
        (file "languages/grammar/elaborate.meta")
        (file "languages/foundation/foundation.meta")
        (file "languages/foundation/derive.meta")
        (file "languages/foundation/delta.meta")
        (file "foundations/S5/surface/strata.generated.meta")
        (file "features/strata/check.generated.meta")
        (file "features/strata/total.generated.meta")
        (file "features/strata/schema.generated.meta")
        (file "features/strata/depend.generated.meta")
        (file "features/strata/change.generated.meta")
        (file "features/strata/law.generated.meta")
        (file "features/strata/resolve.generated.meta")
        (file "features/strata/compile.generated.meta")
      ]))
      (grammars {
        strata (file "foundations/S5/surface/strata.generated.grammar")
        meta (file "languages/meta/meta.generated.grammar")
        grammar (file "languages/grammar/grammar.generated.grammar")
      })
      (entries {})
      (checks (include "fixtures/strata/s5-checks.canon"))
      (kernel (kernel (allow cas-get cas-has hash grammar-parse grammar-print)))
      (resources (budget (steps 400000000) (depth 20000))))))
