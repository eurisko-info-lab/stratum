path%languages/gitignore/gitignore.grammar
textçgrammar "gitignore"
start file

token pattern str "[^\\r\\n \\t]([^\\r\\n]*[^\\r\\n \\t])?"
token newline sym "\\n"
skip "#[^\\n]*"

category file
  fold GitIgnoreFile line

category line
  prod Ignore pattern : pattern newline : newline
  prod Blank newline : newline
