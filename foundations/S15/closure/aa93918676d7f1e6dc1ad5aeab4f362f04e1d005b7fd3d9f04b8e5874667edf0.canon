
artifactsource
source
pathlanguages/yaml/yaml.grammar
textÀgrammar "yaml"
start document

token quoted str "\"[^\"]*\"|'[^']*'"
token spaces str "[ ]+"
token word str "[^ \\t\\r\\n:#\\[\\]{},|]+(://[^ \\t\\r\\n#\\[\\]{},|]*)?"
token newline sym "\\n"
skip "#[^\\n]*"

category document
  fold YamlDocument line

category line
  prod EmptyMapping key : word ":" newline : newline
  prod IndentedEmptyMapping indent : spaces key : word ":" newline : newline
  prod Mapping key : word ":" value : atoms newline : newline
  prod IndentedMapping indent : spaces key : word ":" value : atoms newline : newline
  prod Sequence "-" value : atoms newline : newline
  prod IndentedSequence indent : spaces "-" value : atoms newline : newline
  prod Continuation indent : spaces value : atoms newline : newline
  prod IndentedBlank indent : spaces newline : newline
  prod Blank newline : newline

category atoms
  fold Atoms atom

category atom
  prod Quoted value : quoted
  prod Word value : word
  prod Space value : spaces
  prod OpenList "["
  prod CloseList "]"
  prod OpenMap "{"
  prod CloseMap "}"
  prod Comma ","
  prod Colon ":"
  prod Pipe "|"
