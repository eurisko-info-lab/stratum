# Two local branches diverge from the same patch graph.
$ derive --foundation foundations/F3 --goal '(call BranchesAgree)'
> #f

$ derive --foundation foundations/F3 --goal '(call TopicState)'
> {A ten B twenty}

# Independent patches applied in different orders reach identical state.
$ derive --foundation foundations/F3 --goal '(call IndependentOrderAgrees)'
> #t

# Patch identity does not depend on a mutable branch name.
$ derive --foundation foundations/F3 --goal '(call IdentityIndependentOfBranch)'
> #t

# An overlapping conflict becomes a canonical artifact.
$ derive --foundation foundations/F3 --goal '(call ConflictReason)'
> predecessor-mismatch

$ derive --foundation foundations/F3 --goal '(call ResolvedState)'
> {A resolved B two}

# Unrecording changes branch membership without deleting history.
$ derive --foundation foundations/F3 --goal '(call UnrecordedState)'
> {A one B twenty}

$ derive --foundation foundations/F3 --goal '(call HistoryRetainedAfterUnrecord)'
> #t

# Language, code and data all change through the same mechanism.
$ derive --foundation foundations/F3 --goal '(call MetaEditState)'
> {A one B two C three}

$ derive --foundation foundations/F3 --goal '(call GrammarEditState)'
