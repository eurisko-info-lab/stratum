> result (valid #d8a35e098060900900f674c8394f96779d470275388021d39e1ae2252f720f4f9)

$ foundation reconstruct --dir foundations/F5
> reconstructed F5
> digest 7597906c290ba91511ff77ddc0be2a42e3848b1c2431eaa7ed8649b469fdb5fe
> stable yes
> closure 48 artifacts
> checks 23 ok

# A change is accepted only relative to a constitution.
$ derive --foundation foundations/F5 --goal '(call AcceptedLocal)'
> accepted

$ derive --foundation foundations/F5 --goal '(call AcceptedWithTests)'
> accepted

$ derive --foundation foundations/F5 --goal '(call AcceptedWithProof)'
> accepted

$ derive --foundation foundations/F5 --goal '(call AcceptedMetaChange)'
> accepted

# Every rejection is a distinct constituted reason.
$ derive --foundation foundations/F5 --goal '(call RejectWrongIdentity)'
> bad-signature

$ derive --foundation foundations/F5 --goal '(call RejectWrongPatch)'
> bad-signature

$ derive --foundation foundations/F5 --goal '(call RejectEvidenceForAnotherClaim)'
> missing-proof

$ derive --foundation foundations/F5 --goal '(call RejectExpiredAuthority)'
> expired-authority

$ derive --foundation foundations/F5 --goal '(call RejectInsufficientBudget)'
> insufficient-resource-budget

$ derive --foundation foundations/F5 --goal '(call RejectKindOnlyShortcut)'
> missing-test-evidence

$ derive --foundation foundations/F5 --goal '(call RejectMetaUnderCodeConstitution)'
> kind-not-governed

# Publication requires accepted patches.
$ derive --foundation foundations/F5 --goal '(call BranchWithUnacceptedPatch)'
> (blocked unaccepted-patches)

$ derive --foundation foundations/F5 --goal '(call BranchFullyAccepted)'
> (publishable)
