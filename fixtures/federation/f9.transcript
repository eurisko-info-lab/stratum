> (attestation (name "F9") (foundation #ddb841e0f9f3b97f8ac32d4040e1ab06e6473f82ae37d50c12a3b5755a64fb17e) (application #d7ac2c20e739b77f0371ccf77118f2e95d0f5d6aaa81d4c6421c511cc8f11884a) (meta #dab7068e41479f974df6bd48e18893bd18d245f021339bdb1223906aaa4e5f712) (closure 66) (kinds {application 10 change 11 foundation 10 grammar 3 meta-program 28 source 4}) (complete #t))
