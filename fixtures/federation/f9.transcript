# Two consecutive publication transitions settle.
$ derive --foundation foundations/F9 --goal '(call SettledHeight (call SettleTwo (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon") (file "foundations/F6/foundation.canon")))'
> 2

# A certificate for another proposal is rejected.
$ derive --foundation foundations/F9 --goal '(call SettlementRejection (call SettleWrongCertificate (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon") (file "foundations/F6/foundation.canon")))'
> certificate-for-another-proposal

# Insufficient agreement is rejected.
$ derive --foundation foundations/F9 --goal '(call SettlementRejection (call SettleInsufficient (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon")))'
> insufficient-quorum

# The wrong federation identity is rejected.
$ derive --foundation foundations/F9 --goal '(call SettlementRejection (call SettleWrongFederation (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon")))'
> wrong-federation

# Semantic validity comes before agreement.
$ derive --foundation foundations/F9 --goal '(call SemanticallyInvalidVote (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon"))'
> (abstained semantically-invalid)

# Double voting produces evidence.
$ derive --foundation foundations/F9 --goal '(prim tag (call DoubleVote (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon") (file "foundations/F6/foundation.canon")))'
> equivocation

# Membership changes only through a settled transition.
$ derive --foundation foundations/F9 --goal '(call MembershipAfterSettlement (file "foundations/F4/foundation.canon") (file "foundations/F5/foundation.canon") (file "foundations/F6/foundation.canon"))'
> 5

$ derive --foundation foundations/F9 --goal '(call QuorumSize (call Federation))'
> 3
