; Executable acceptance checks for F9: constituted agreement and settlement.
[
  ; ------------------------------------------------------------ settlement

  (check two-consecutive-transitions-settle
    (call SettledHeight
      (call SettleTwo
        (q (file "foundations/F4/foundation.canon"))
        (q (file "foundations/F5/foundation.canon"))
        (q (file "foundations/F6/foundation.canon"))))
    (value 2))

  (check settled-head-is-the-last-successor
    (prim eq
      (call SettledHead
        (call SettleTwo
          (q (file "foundations/F4/foundation.canon"))
          (q (file "foundations/F5/foundation.canon"))
          (q (file "foundations/F6/foundation.canon"))))
      (q (file "foundations/F6/foundation.canon")))
    (value #t))

  ; ------------------------------------------------------------ rejections

  (check a-certificate-for-another-proposal-is-rejected
    (call SettlementRejection
      (call SettleWrongCertificate
        (q (file "foundations/F4/foundation.canon"))
        (q (file "foundations/F5/foundation.canon"))
        (q (file "foundations/F6/foundation.canon"))))
    (value certificate-for-another-proposal))

  (check insufficient-agreement-is-rejected
    (call SettlementRejection
      (call SettleInsufficient
        (q (file "foundations/F4/foundation.canon"))
        (q (file "foundations/F5/foundation.canon"))))
    (value insufficient-quorum))

  (check the-wrong-federation-identity-is-rejected
    (call SettlementRejection
      (call SettleWrongFederation
        (q (file "foundations/F4/foundation.canon"))
        (q (file "foundations/F5/foundation.canon"))))
    (value wrong-federation))

  ; -------------------------------------------- semantic validity first

  (check a-replica-abstains-from-a-semantically-invalid-transition
    (call SemanticallyInvalidVote
      (q (file "foundations/F4/foundation.canon"))
      (q (file "foundations/F5/foundation.canon")))
    (value (abstained semantically-invalid)))

  ; ------------------------------------------------------------ equivocation

  (check double-voting-is-detected
    (prim tag
      (call DoubleVote
        (q (file "foundations/F4/foundation.canon"))
        (q (file "foundations/F5/foundation.canon"))
        (q (file "foundations/F6/foundation.canon"))))
    (value equivocation))

  (check honest-voting-produces-no-evidence
    (call HonestVotes
      (q (file "foundations/F4/foundation.canon"))
      (q (file "foundations/F5/foundation.canon")))
    (value (none)))

  ; -------------------------------------------------------- membership

  (check membership-changes-through-a-settled-transition
    (call MembershipAfterSettlement
      (q (file "foundations/F4/foundation.canon"))
      (q (file "foundations/F5/foundation.canon"))
      (q (file "foundations/F6/foundation.canon")))
    (value 5))

  (check agreement-threshold-is-three-f-plus-one
    (call QuorumSize (call Federation))
    (value 3))

  ; ------------------------------- earlier foundation behaviour is intact

  (check synchronization-unchanged
    (call DisjointSync)
    (value (synchronized 2)))

  (check lambda-behaviour-unchanged
    (call NormalizeToText (q (file "languages/lambda/lambda.generated.grammar")) (q "(\\x. \\y. x) a b"))
    (value "a"))
]
