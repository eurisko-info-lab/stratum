; Executable acceptance checks for F8: distributed closure and branch
; synchronization.
[
  ; ---------------------------------------------------- closure exchange

  (check two-peers-synchronize-from-disjoint-closures
    (call DisjointSync)
    (value (synchronized 2)))

  (check synchronized-store-holds-both-closures
    (call SyncedSize)
    (value 4))

  (check corrupted-artifact-bytes-are-rejected
    (call CorruptedTransfer)
    (value (interrupted corrupted-artifact)))

  (check an-interrupted-transfer-resumes
    (call ResumedTransfer)
    (value (synchronized 1)))

  ; ------------------------------------------------------- advertisement

  (check closure-offers-are-digest-addressed
    (prim len (call ClosureOffer'digests (call AdvertiseClosure (call PeerIdentity (q remote)) (call LeftStore))))
    (value 2))

  (check missing-objects-are-discovered
    (prim len
      (call NeededDigests
        (call LeftStore)
        (call AdvertiseClosure (call PeerIdentity (q remote)) (call RightStore))))
    (value 2))

  ; ---------------------------------------------------- branch exchange

  (check remote-patches-arrive-as-proposals
    (call RemoteProposals)
    (value 1))

  (check diverged-branches-preserve-explicit-conflicts
    (call DivergedConflicts
      (call DescProgram)
      (call BaseState)
      (call ConflictRepo)
      (q main))
    (value 1))

  ; ------------------------------------------------------------ transport

  (check the-transport-carries-canonical-messages
    (call TransportRoundTrip)
    (value (message (advertise main [p1]))))

  ; -------------------------------------------------------- offline usage

  (check local-replay-works-without-a-network
    (call OfflineStateUnchanged
      (call DescProgram)
      (call BaseState)
      (call RepoOrderOne)
      (q main))
    (value #t))

  ; ------------------------------- earlier foundation behaviour is intact

  (check chain-replay-unchanged
    (call ChainHeight
      (call ReplayFromGenesis
        (call ChainAuthority)
        (call GoodChain
          (q (file "languages/lambda/lambda.generated.grammar"))
          (q (file "languages/lambda/lambda.generated.meta")))))
    (value 2))

  (check lambda-behaviour-unchanged
    (call NormalizeToText (q (file "languages/lambda/lambda.generated.grammar")) (q "(\\x. \\y. x) a b"))
    (value "a"))
]
