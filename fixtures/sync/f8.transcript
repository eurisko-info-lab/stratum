$ foundation reconstruct --dir foundations/F8
> reconstructed F8
> digest dc1a07cbb466bb2a3ee36fa3e768f9fe937a9aed559559f33164f4a3264ed16b
> stable yes
> closure 61 artifacts
> checks 12 ok

# Two peers with disjoint partial closures synchronize.
$ derive --foundation foundations/F8 --goal '(call DisjointSync)'
> (synchronized 2)

$ derive --foundation foundations/F8 --goal '(call SyncedSize)'
> 4

# Corrupted artifact bytes are rejected on receipt.
$ derive --foundation foundations/F8 --goal '(call CorruptedTransfer)'
> (interrupted corrupted-artifact)

# An interrupted transfer resumes from what is already held.
$ derive --foundation foundations/F8 --goal '(call ResumedTransfer)'
> (synchronized 1)

# Remote patches arrive as proposals, never as accepted members.
$ derive --foundation foundations/F8 --goal '(call RemoteProposals)'
> 1

# Diverged branches preserve explicit conflicts.
$ derive --foundation foundations/F8 --goal '(call DivergedConflicts (call DescProgram) (call BaseState) (call ConflictRepo) (q main))'
> 1

# The generic transport carries canonical messages.
$ derive --foundation foundations/F8 --goal '(call TransportRoundTrip)'
> (message (advertise main [p1]))

# A local repository stays usable without a network.
$ derive --foundation foundations/F8 --goal '(call OfflineStateUnchanged (call DescProgram) (call BaseState) (call RepoOrderOne) (q main))'
> #t
