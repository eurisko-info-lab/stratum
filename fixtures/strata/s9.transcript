# The elaborator is an ordinary Strata module.
$ derive --foundation foundations/S9 --goal '(call CheckLinkedNative (grammar strata) (call StrataMetaSystem (call SourceText (source "strata/lib/prelude.strata")) (call SourceText (source "strata/system/native.strata")) (call SourceText (source "strata/system/meta.strata"))) (q "strata.meta"))'
> (checked ok)

$ derive --foundation foundations/S9 --goal '(call TotalLinkedModule (grammar strata) (call StrataMetaSystem (call SourceText (source "strata/lib/prelude.strata")) (call SourceText (source "strata/system/native.strata")) (call SourceText (source "strata/system/meta.strata"))) (q "strata.meta"))'
> (total ok)

# The smallest Meta source in the tree, elaborated in Strata. This is the
# whole artifact, and it is the file that is committed.
$ derive --foundation foundations/S9 --goal '(call ElaborateMetaInStrata (grammar strata) (call StrataMetaSystem (call SourceText (source "strata/lib/prelude.strata")) (call SourceText (source "strata/system/native.strata")) (call SourceText (source "strata/system/meta.strata"))) (grammar meta) (call SourceText (source "languages/text/text.meta")))'
> (program (module text) (judgment TextFile [text] (mk TextFile (v text))) (judgment TextFile'text [record] (prim nth (prim args (v record)) (q 0))) (judgment ParseText [grammar source] (call Parse (v grammar) (v source))) (judgment PrintText [grammar syntax] (call Print (v grammar) (v syntax))) (judgment TextWellFormed [grammar source] (match (call ParseText (v grammar) (v source)) (case (pm TextFile (pv text)) (mk valid (prim slen (v text)))) (case _ (mk invalid (q parse))))))

# The same function, not the same bytes by luck: both elaborators run, and
# their results compared.
$ derive --foundation foundations/S9 --goal '(call StrataMetaMatchesMeta (grammar strata) (call StrataMetaSystem (call SourceText (source "strata/lib/prelude.strata")) (call SourceText (source "strata/system/native.strata")) (call SourceText (source "strata/system/meta.strata"))) (grammar meta) (call SourceText (source "features/strata/native.meta")))'
