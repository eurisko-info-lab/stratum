; Executable acceptance checks for S6, effects and multiplicities.
;
; S2 lets a type mention a value. S6 lets a declaration say what happens: what
; a definition needs permission to do, and how many times a parameter may be
; used. Neither is a comment.
[
  ; -------------------------------------------------------------- the surface

  ; A capability clause and a multiplicity print back byte for byte, like
  ; everything else.
  (check strata-graded-surface-prints-exactly
    (call PrintsExactly
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q "module \"probe.g\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef useOnce [once n: Nat] ! io: Nat = n\ndef dropIt [erased n: Nat]: Nat = Zero\n"))
    (value #t))

  ; A module written before there was either still parses, because a
  ; foundation may not take away what its predecessor could say.
  (check strata-ungraded-modules-still-parse
    (call PrintsExactly
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (call SourceText (q (text-file "strata/lib/vector.strata"))))
    (value #t))

  ; A grade is written on the parameter but is not part of it: the canonical
  ; parameter is what it always was, and the grades are collected beside it,
  ; so nothing that already reads a declaration has to learn a second shape.
  (check strata-a-grade-is-collected-beside-the-parameter
    (call Declarations
      (call ParseStrata
        (q (file "foundations/S6/surface/strata.generated.grammar"))
        (q "module \"probe.g\"\nversion 1\ndata Bool = | True [] | False []\ndef useOnce [once b: Bool] ! io: Bool = b\n")))
    (value [
      (data Bool [(Constructor True (NoFields)) (Constructor False (NoFields))])
      (def useOnce [(Param b (TypeRef Bool))] (TypeRef Bool) (Var b))
      (grades useOnce [(graded b once)])
      (uses useOnce [io])]))

  ; ------------------------------------------------------------ capabilities

  ; A capability is not acquired by going one call deeper.
  (check strata-a-capability-does-not-travel
    (call CheckLinkedCapabilities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.c\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef raw []! io: Nat = Zero\ndef quiet []: Nat = raw\n"])
      (q "probe.c"))
    (error capability-error))

  ; Declaring it is what makes the call permitted.
  (check strata-declaring-a-capability-permits-the-call
    (call CheckLinkedCapabilities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.c\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef raw []! io: Nat = Zero\ndef loud []! io: Nat = raw\n"])
      (q "probe.c"))
    (value (permitted ok)))

  ; The library the floor ships declares what it needs.
  (check strata-library-effects-is-permitted
    (call CheckLinkedCapabilities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/effects.strata")))
          (q [])))
      (q "strata.effects"))
    (value (permitted ok)))

  ; ---------------------------------------------------------- multiplicities

  ; A parameter declared `once` is used once on every path, and the rejection
  ; says which path it was not.
  (check strata-a-once-parameter-used-twice-is-rejected
    (call CheckLinkedMultiplicities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.m\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\ndef twice [once n: Nat]: Nat = add n n\n"])
      (q "probe.m"))
    (error multiplicity-error))

  ; And a path that does not use it at all is just as wrong.
  (check strata-a-once-parameter-unused-on-a-path-is-rejected
    (call CheckLinkedMultiplicities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.m\"\nversion 1\ndata Bool = | True [] | False []\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef maybe [once n: Nat, b: Bool]: Nat = match b of case True -> n case False -> Zero end\n"])
      (q "probe.m"))
    (error multiplicity-error))

  ; `affine` allows the path that does not use it.
  (check strata-an-affine-parameter-may-go-unused
    (call CheckLinkedMultiplicities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.m\"\nversion 1\ndata Bool = | True [] | False []\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef maybe [affine n: Nat, b: Bool]: Nat = match b of case True -> n case False -> Zero end\n"])
      (q "probe.m"))
    (value (used ok)))

  ; But not the path that uses it twice.
  (check strata-an-affine-parameter-used-twice-is-rejected
    (call CheckLinkedMultiplicities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.m\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\ndef twice [affine n: Nat]: Nat = add n n\n"])
      (q "probe.m"))
    (error multiplicity-error))

  ; `erased` means used on no path at all, which is what makes it removable.
  (check strata-an-erased-parameter-that-is-used-is-rejected
    (call CheckLinkedMultiplicities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (q ["module \"probe.m\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef keep [erased n: Nat]: Nat = n\n"])
      (q "probe.m"))
    (error multiplicity-error))

  (check strata-library-effects-uses-what-it-declares
    (call CheckLinkedMultiplicities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/effects.strata")))
          (q [])))
      (q "strata.effects"))
    (value (used ok)))

  ; --------------------------------------------------------------- erasure

  ; What is erased is gone: the definition that took it no longer takes it.
  ; The list is the arity of every definition in the linked module, prelude
  ; first. `dropIt` is the tenth, declared with one parameter and compiled
  ; with none.
  (check strata-erasure-removes-the-parameter
    (call ErasedArities
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/effects.strata")))
          (q [])))
      (q "strata.effects"))
    (value [1 2 2 2 2 1 2 1 1 0 2 0 0 0]))

  ; And the program still computes what it computed. This is the obligation
  ; erasure carries: removing what cannot be observed does not change what is.
  (check strata-erasure-preserves-meaning
    (call ErasurePreservesMeaning
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/compiler/compile.strata")))
          (q [])))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/effects.strata")))
          (q [])))
      (q "strata.effects")
      (q erasedExample))
    (value #t))

  (check strata-erasure-preserves-a-once-parameter
    (call ErasurePreservesMeaning
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/compiler/compile.strata")))
          (q [])))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/effects.strata")))
          (q [])))
      (q "strata.effects")
      (q onceExample))
    (value #t))

  (check strata-erasure-preserves-a-match
    (call ErasurePreservesMeaning
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/compiler/compile.strata")))
          (q [])))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/effects.strata")))
          (q [])))
      (q "strata.effects")
      (q affineExample))
    (value #t))

  ; ------------------------------------------------------------- the floor

  ; What the layers below decided, S6 still decides -- including the
  ; bootstrap, which is run against the surface as it now stands.
  (check strata-the-bootstrap-is-still-stable
    (call BootstrapIsStable
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/compiler/compile.strata")))
          (q []))))
    (value #t))

  (check strata-the-vector-still-checks
    (call CheckLinkedDependent
      (q (file "foundations/S6/surface/strata.generated.grammar"))
      (prim cons
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (prim cons
          (call SourceText (q (text-file "strata/lib/vector.strata")))
          (q [])))
      (q "strata.vector"))
    (value (checked ok)))
]
