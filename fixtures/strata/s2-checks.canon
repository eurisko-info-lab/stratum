; Executable acceptance checks for S2, the dependent core.
;
; S1 decides whether a module is well formed. S2 decides the same question
; when a type mentions a value.
[
  ; ------------------------------------------------------------- telescopes

  ; A family is declared with a telescope, and each constructor says which
  ; index it lands on.
  (check strata-checks-an-indexed-family
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.vec\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a Zero | Cons [head #1: a, tail #2: Vec a n]: Vec a (Succ n)\ndef example []: Nat = Zero\n"))
    (value (checked ok)))

  ; A parameter declared with a type nothing declares is a kind error.
  (check strata-rejects-an-undeclared-parameter-type
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.bad\"\nversion 1\ndata Vec [a: Type, n: Missing] = | Nil []: Vec a Missing\ndef example []: Nat = Zero\n"))
    (error kind-error))

  ; Nothing may be its own type.
  (check strata-rejects-a-family-that-parameterises-itself
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.cyclic\"\nversion 1\ndata Loop [a: Loop] = | Wrap []: Loop a\ndef example []: Nat = Zero\n"))
    (error kind-error))

  ; --------------------------------------------------------------- indices

  ; A constructor must land on the family that declares it.
  (check strata-rejects-a-constructor-that-lands-elsewhere
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.elsewhere\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndata Vec [a: Type, n: Nat] = | Nil []: Nat\ndef example []: Nat = Zero\n"))
    (error index-error))

  ; And must saturate the indices of that family.
  (check strata-rejects-an-unsaturated-index
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.short\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a\ndef example []: Nat = Zero\n"))
    (error index-error))

  ; A constructor of a family must say where it lands at all.
  (check strata-requires-an-index-on-a-family-constructor
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.silent\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndata Vec [a: Type, n: Nat] = | Nil []\ndef example []: Nat = Zero\n"))
    (error index-error))

  ; ---------------------------------------------------------- normalisation

  ; A type that mentions a definition is compared after computation, so
  ; `add Zero Zero` and `Zero` name the same index.
  (check strata-normalises-an-index-before-comparing
    (call SameType
      (call DependentConstructors
        (call Declarations
          (call ParseStrata
            (q (file "foundations/S2/surface/strata.generated.grammar"))
            (q "module \"strata.n\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\n"))))
      (call DependentDefinitions
        (call Declarations
          (call ParseStrata
            (q (file "foundations/S2/surface/strata.generated.grammar"))
            (q "module \"strata.n\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\n"))))
      (q (apply (apply (con add) (con Zero)) (con Zero)))
      (q (con Zero)))
    (value #t))

  ; Two indices that do not compute to the same value are not the same type.
  (check strata-separates-indices-that-differ
    (call SameType
      (call DependentConstructors
        (call Declarations
          (call ParseStrata
            (q (file "foundations/S2/surface/strata.generated.grammar"))
            (q "module \"strata.n\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\n"))))
      (call DependentDefinitions
        (call Declarations
          (call ParseStrata
            (q (file "foundations/S2/surface/strata.generated.grammar"))
            (q "module \"strata.n\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\n"))))
      (q (apply (apply (con add) (con Zero)) (con Zero)))
      (q (apply (con Succ) (con Zero))))
    (value #f))

  ; A definition whose index does not add up is a type error, and that is the
  ; whole point of the layer: the length of an appended vector is decided, not
  ; asserted.
  (check strata-rejects-an-append-whose-index-does-not-add-up
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.bad\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a Zero | Cons [head #1: a, tail #2: Vec a n]: Vec a (Succ n)\ndef append [a: Type, m: Nat, n: Nat, xs: Vec a m, ys: Vec a n]: Vec a m = match xs of case Nil b -> ys case Cons b p h t -> Cons b (add p n) h (append b p n t ys) end\n"))
    (error type-error))

  ; A proof of equality rewrites one side into the other.
  (check strata-rewrites-along-a-proof
    (call RewriteAlong
      (call DependentConstructors
        (call Declarations
          (call ParseStrata
            (q (file "foundations/S2/surface/strata.generated.grammar"))
            (q "module \"strata.n\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\n"))))
      (call DependentDefinitions
        (call Declarations
          (call ParseStrata
            (q (file "foundations/S2/surface/strata.generated.grammar"))
            (q "module \"strata.n\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\n"))))
      (q (apply (apply (apply (con Eq) (con Nat)) (con m)) (apply (apply (con add) (con Zero)) (con m))))
      (q (apply (apply (con Vec) (con a)) (con m))))
    (value (apply (apply (con Vec) (con a)) (con m))))

  ; ---------------------------------------------------------------- surface

  ; The dependent surface prints back byte for byte, like the seed's.
  (check strata-dependent-surface-prints-exactly
    (call PrintsExactly
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.vec\"\nversion 1\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a Zero | Cons [head #1: a, tail #2: Vec a n]: Vec a (Succ n)\ndef idv [a: Type]: [n: Nat] -> Vec a n = grow\n"))
    (value #t))

  ; The seed surface still parses, because a foundation may not take away what
  ; its predecessor could say.
  (check strata-seed-surface-still-parses
    (call PrintsExactly
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.check\"\nversion 1\ndata Bit = | On [] | Off []\ndef flip [b: Bit]: Bit = match b of case On -> Off case Off -> On end\ndef example []: Bit = flip Off\n"))
    (value #t))

  ; --------------------------------------------------------------- library

  ; A family indexed by a value, and the operations a length index makes
  ; total. It is written out here rather than shipped as a file, because a
  ; module that redeclares `Nat` is not a library -- it is the same
  ; declaration written twice. The library arrives at S4, when a module can
  ; import what it needs instead.
  (check strata-an-indexed-vector-is-well-formed
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.vector\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a Zero | Cons [head #1: a, tail #2: Vec a n]: Vec a (Succ n)\ndef append [a: Type, m: Nat, n: Nat, xs: Vec a m, ys: Vec a n]: Vec a (add m n) = match xs of case Nil b -> ys case Cons b p h t -> Cons b (add p n) h (append b p n t ys) end\ndata Eq [a: Type, x: a, y: a] = | Refl []: Eq a x x\ndef zeroAdds [n: Nat]: Eq Nat n n = Refl Nat n\ndef single [a: Type, x: a]: Vec a (Succ Zero) = Cons a Zero x (Nil a)\ndef pair [a: Type, x: a, y: a]: Vec a (Succ (Succ Zero)) = append a (Succ Zero) (Succ Zero) (single a x) (single a y)\n"))
    (value (checked ok)))

  ; Its length arithmetic terminates.
  (check strata-an-indexed-vector-terminates
    (call TotalModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.vector\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndef add [m: Nat, n: Nat]: Nat = match m of case Zero -> n case Succ p -> Succ (add p n) end\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a Zero | Cons [head #1: a, tail #2: Vec a n]: Vec a (Succ n)\ndef append [a: Type, m: Nat, n: Nat, xs: Vec a m, ys: Vec a n]: Vec a (add m n) = match xs of case Nil b -> ys case Cons b p h t -> Cons b (add p n) h (append b p n t ys) end\ndata Eq [a: Type, x: a, y: a] = | Refl []: Eq a x x\ndef zeroAdds [n: Nat]: Eq Nat n n = Refl Nat n\ndef single [a: Type, x: a]: Vec a (Succ Zero) = Cons a Zero x (Nil a)\ndef pair [a: Type, x: a, y: a]: Vec a (Succ (Succ Zero)) = append a (Succ Zero) (Succ Zero) (single a x) (single a y)\n"))
    (value (total ok)))

  ; The library's worked examples are load-bearing rather than illustrative:
  ; the same module with a length that is off by one does not check.
  (check strata-rejects-a-length-that-is-off-by-one
    (call CheckDependentModule
      (q (file "foundations/S2/surface/strata.generated.grammar"))
      (q "module \"strata.off\"\nversion 1\ndata Nat = | Zero [] | Succ [pred #1: Nat]\ndata Vec [a: Type, n: Nat] = | Nil []: Vec a Zero | Cons [head #1: a, tail #2: Vec a n]: Vec a (Succ n)\ndef single [a: Type, x: a]: Vec a (Succ Zero) = Cons a Zero x (Nil a)\ndef pair [a: Type, x: a, y: a]: Vec a (Succ Zero) = Cons a (Succ Zero) x (single a y)\n"))
    (error type-error))
]
