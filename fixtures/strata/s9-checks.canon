  (check strata-elaborates-languages-typescript-typescript
    (call StrataMetaAgrees
      (q (file "foundations/S9/surface/strata.generated.grammar"))
      (call StrataMetaSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/meta.strata"))))
      (q (file "languages/meta/meta.generated.grammar"))
      (call SourceText (q (text-file "languages/typescript/typescript.meta")))
      (q (file "languages/typescript/typescript.generated.meta")))
