  (check strata-elaborates-languages-yaml-yaml
    (call StrataMetaAgrees
      (q (file "foundations/S9/surface/strata.generated.grammar"))
      (call StrataMetaSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/meta.strata"))))
      (q (file "languages/meta/meta.generated.grammar"))
      (call SourceText (q (text-file "languages/yaml/yaml.meta")))
      (q (file "languages/yaml/yaml.generated.meta")))
    (value (agree ok)))

  ; --------------------------------------------- the same function, not the
  ;                                                same bytes by luck
  ;
  ; Every check above compares against a committed artifact, which the Meta
  ; elaborator produced at some point in the past. These two run both
  ; elaborators now and compare what they return, so what is being decided is
  ; that the two are the same function -- not that one of them once agreed
  ; with a file.

  (check strata-is-the-same-function-as-meta-on-text
    (call StrataMetaMatchesMeta
      (q (file "foundations/S9/surface/strata.generated.grammar"))
      (call StrataMetaSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/meta.strata"))))
      (q (file "languages/meta/meta.generated.grammar"))
      (call SourceText (q (text-file "languages/text/text.meta"))))
    (value (agree ok)))

  (check strata-is-the-same-function-as-meta-on-the-boundary
    (call StrataMetaMatchesMeta
      (q (file "foundations/S9/surface/strata.generated.grammar"))
      (call StrataMetaSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/meta.strata"))))
      (q (file "languages/meta/meta.generated.grammar"))
      (call SourceText (q (text-file "features/strata/native.meta"))))
    (value (agree ok)))
]
