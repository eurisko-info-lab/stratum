      (call SourceText (q (text-file "languages/shell/shell.meta")))
      (q (file "languages/shell/shell.generated.meta")))
    (value (agree ok)))

  (check strata-elaborates-languages-strata-strata
    (call StrataMetaAgrees
      (q (file "foundations/S9/surface/strata.generated.grammar"))
      (call StrataMetaSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/meta.strata"))))
      (q (file "languages/meta/meta.generated.grammar"))
      (call SourceText (q (text-file "languages/strata/strata.meta")))
      (q (file "languages/strata/strata.generated.meta")))
    (value (agree ok)))

  (check strata-elaborates-languages-text-text
    (call StrataMetaAgrees
      (q (file "foundations/S9/surface/strata.generated.grammar"))
      (call StrataMetaSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/meta.strata"))))
      (q (file "languages/meta/meta.generated.grammar"))
