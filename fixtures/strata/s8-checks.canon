      (q (file "foundations/S8/surface/strata.generated.grammar"))
      (call StrataSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
        (call SourceText (q (text-file "strata/system/grammar.strata"))))
      (q (file "languages/grammar/grammar.generated.grammar"))
      (call SourceText (q (text-file "languages/strata/strata.grammar")))
      (q (file "languages/strata/strata.generated.grammar")))
    (value (agree ok)))

  (check strata-elaborates-the-scala-grammar
    (call StrataGrammarAgrees
      (q (file "foundations/S8/surface/strata.generated.grammar"))
      (call StrataSystem
        (call SourceText (q (text-file "strata/lib/prelude.strata")))
        (call SourceText (q (text-file "strata/system/native.strata")))
