# F1 acceptance transcript: self-described Meta and Grammar.
# The lambda language of F1 is elaborated from Meta1 and Grammar1 sources.

$ foundation verify --dir foundations/F1
> foundation F1
> digest 81b5534d04b41bb4681dae026195c74e82c59b6e0a236b4457b6b6b2d38ec96e
> closure 26 artifacts
> check meta1-parse-print-roundtrip ok
> check grammar1-parse-print-roundtrip ok
> check grammar1-describes-itself ok
> check meta1-grammar-reconstructs ok
> check lambda-grammar-reconstructs ok
> check lambda-program-fixpoint ok
> check elaboration-stable-under-printing ok
> check delta-meta-applies ok
> check delta-grammar-applies ok
> check delta-meta-is-predecessor-bound ok
> check parse-print-roundtrip ok
> check beta-deterministic ok
> check beta-church-two ok
> check alpha-equivalent ok
> check alpha-distinct ok
> check free-variables ok
> check resource-exhaustion-is-a-verdict ok
> verdict ok

$ foundation closure --dir foundations/F1
> closure 26 artifacts
> application 2
> change 3
> data 1
> foundation 2
> grammar 3
> meta-program 11
> source 4

# The predecessor validates the successor.
$ foundation verify-successor --predecessor foundations/F0 --successor foundations/F1
> predecessor F0
> successor F1
> result (valid #dc2f05a4c95d05a65bfab52ad0fe722f1491de94f24d5d200232011661d10ad77)

# The successor reconstructs itself from its own closure.
$ foundation reconstruct --dir foundations/F1
> reconstructed F1
> digest 81b5534d04b41bb4681dae026195c74e82c59b6e0a236b4457b6b6b2d38ec96e
> stable yes
> closure 26 artifacts
> checks 17 ok

# Grammar1 parses its own grammar and rebuilds the committed artifact.
$ derive --foundation foundations/F1 --goal '(call GrammarReconstructs (grammar grammar1) (call SourceText (source "languages/grammar1/grammar1.grammar")) (grammar grammar1))'
> (reconstruct ok)

# Meta1 elaborates the lambda language back to its canonical Meta0 artifact.
$ derive --foundation foundations/F1 --goal '(call ElaborationStable (grammar meta1) (call SourceText (source "languages/lambda/lambda.meta")))'
> #t

# The canonical change from F0 to F1 is predecessor bound.
$ derive --foundation foundations/F1 --goal '(call ApplyDelta (file "changes/F0-F1/delta-meta.canon") (q (bootstrap meta0)))'
> (applied (surface meta1))

$ derive --foundation foundations/F1 --goal '(call ApplyDelta (file "changes/F0-F1/delta-meta.canon") (q (surface meta1)))'
> (rejected predecessor-mismatch)

# Lambda behaviour is identical to F0.
$ derive --foundation foundations/F1 --goal '(call NormalizeToText (grammar lambda) (q "(\\x. \\y. x) a b"))'
> "a"

$ derive --foundation foundations/F1 --goal '(call NormalizeToText (grammar lambda) (q "(\\f. \\x. f (f x)) g y"))'
> "g (g y)"

$ derive --foundation foundations/F1 --goal '(call AlphaEquivalent (grammar lambda) (q "\\x. x") (q "\\y. y"))'
> #t

$ derive --foundation foundations/F1 --goal '(call NormalizeToText (grammar lambda) (q "(\\x. x x) (\\x. x x)"))' --budget 20000
> error resource-exhausted "budget of 20000 steps exhausted"
> exit 1
