; Executable acceptance checks for F11: profile-guided studios and the complete
; publication workflow.
[
  ; ----------------------------------------------------- separate schemas

  (check the-runtime-offers-only-generic-primitives
    (call Primitives)
    (value [tree list table text form graph inspector diff conflict preview queue palette]))

  (check both-profiles-compose-the-same-runtime
    (call SharesRuntime (call AlphaProfile) (call BetaProfile))
    (value #t))

  ; ------------------------------------------- the studios visibly differ

  (check studios-do-not-collapse-into-one-interface
    (call StudiosCollapse)
    (value #f))

  (check panel-arrangement-navigation-commands-workflow-editors-and-previews-differ
    (call ProfilesDifferIn (call AlphaProfile) (call BetaProfile))
    (value (differences #f #f #f #f #f #f #f)))

  (check one-profile-navigates-its-own-way
    (call StudioNavigation (call AlphaStudio))
    (value (navigation root-item [root item])))

  (check the-other-navigates-differently
    (call StudioNavigation (call BetaStudio))
    (value (navigation group-item [group item])))

  (check one-profile-arranges-its-own-panels
    (call StudioPanels (call AlphaStudio))
    (value [outline detail]))

  (check the-other-arranges-different-panels
    (call StudioPanels (call BetaStudio))
    (value [index body log]))

  (check one-profile-offers-its-own-commands
    (call StudioActions (call AlphaStudio))
    (value [open-item]))

  (check the-other-offers-different-commands
    (call StudioActions (call BetaStudio))
    (value [create-item review-item]))

  (check a-workflow-is-whatever-the-profile-says
    (call StudioWorkflow (call BetaStudio))
    (value [draft review done]))

  (check foreign-surfaces-are-declared-not-assumed
    (call DeriveForeignProjection (call BetaProfile))
    (value [zip]))

  (check field-editors-are-declared-not-assumed
    (call DeriveEditor (call BetaProfile))
    (value [rich-text numeric]))

  ; -------------------------------- semantics and surface stay separate

  (check relayout-does-not-change-the-semantic-digest
    (call RelayoutIsSemanticallyNeutral (call AlphaLanguage) (call AlphaProfile) (q single-pane))
    (value #t))

  (check a-conflict-editor-is-derived
    (call DeriveConflictEditor (call AlphaProfile))
    (value (ViewSchema conflicts conflict repository)))

  (check a-repository-browser-is-derived
    (call DeriveRepositoryBrowser (call BetaProfile))
    (value (ViewSchema branches tree repository)))

  ; ------------------------------------- complete chain to workspace loop

  (check the-round-trip-has-seventeen-stages
    (call RoundTripStageCount (q (file "languages/lambda/lambda.generated.grammar")))
    (value 17))

  (check the-round-trip-changes-a-language
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q change-language))
    (value {atom [(entry Var varprod) (entry Hole holeprod)]}))

  (check the-round-trip-changes-code
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q change-code))
    (value "\\ x. z"))

  (check the-round-trip-changes-data
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q change-data))
    (value {A one B two C three}))

  (check independent-patches-commute-in-the-round-trip
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q commute-independent-patches))
    (value #t))

  (check conflicts-stay-explicit-in-the-round-trip
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q explicit-conflicts))
    (value predecessor-mismatch))

  (check acceptance-runs-locally-in-the-round-trip
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q run-acceptance))
    (value accepted))

  (check a-fresh-node-reconstructs-the-state
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q reconstruct-on-fresh-node))
    (value [meta0-grammar0 hosts canonical]))

  (check the-studios-reopen-the-reconstructed-state
    (call StageResult (q (file "languages/lambda/lambda.generated.grammar")) (q reopen-studios))
    (value [outline detail]))

  ; ------------------------------- earlier foundation behaviour is intact

  (check retention-unchanged
    (call DiscardedKinds)
    (value [tools index projection]))

  (check lambda-behaviour-unchanged
    (call NormalizeToText (q (file "languages/lambda/lambda.generated.grammar")) (q "(\\x. \\y. x) a b"))
    (value "a"))
]
