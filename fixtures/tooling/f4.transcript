> checks 17 ok

# Tools are selected by role from the schema, not hand written.
$ derive --foundation foundations/F4 --goal '(call DerivedRoles (grammar lambda))'
> [parse print format evaluate compile executeTarget index rename diagnostics validateChange]

$ derive --foundation foundations/F4 --goal '(call ToolJudgment (call ToolchainFor (grammar lambda)) (q compile))'
> CompileTerm

# Changing the grammar regenerates the tools that depend on it.
$ derive --foundation foundations/F4 --goal '(call GrammarChangeAffectsTools (grammar lambda) (grammar meta1) (q parse))'
> #f

# The evaluator is the judgment the schema selected.
$ derive --foundation foundations/F4 --goal '(call RunRole (call LambdaSchema (grammar lambda)) (q evaluate) (call Parse (grammar lambda) (q "(\\x. \\y. x) a b")))'
> (Var a)

# The formatter is canonical printing.
$ derive --foundation foundations/F4 --goal '(call FormatSource (grammar lambda) (q "(\\x.     x)   y"))'
> "(\\ x. x) y"

# Symbol index and rename are generated.
$ derive --foundation foundations/F4 --goal '(call IndexTerm (call Parse (grammar lambda) (q "\\x. f x")) (q []))'
> [(symbol binder x []) (symbol reference f [(field body) (field fn)]) (symbol reference x [(field body) (field argument)])]

$ derive --foundation foundations/F4 --goal '(call RenameSource (grammar lambda) (q "\\y. f y") (q f) (q h))'
> "\\ y. h y"

$ derive --foundation foundations/F4 --goal '(call DiagnoseSource (grammar lambda) (q "\\x. \\x. x"))'
> [(Finding shadowed-binder x)]

# Lambda compiles to the stack target, which is another language artifact.
$ derive --foundation foundations/F4 --goal '(call CompileSource (grammar lambda) (q "(\\x. x) a"))'
> [(PUSH [(FREE a)]) (GRAB [(ACCESS 0)])]

# Compiled execution agrees with direct evaluation on the regression corpus.
$ derive --foundation foundations/F4 --goal '(call CompiledExecutionAgrees (grammar lambda))'
> #t

$ derive --foundation foundations/F4 --goal '(call ExecuteSourceToText (grammar lambda) (q "(\\f. \\x. f x) g y"))'
> "g y"
