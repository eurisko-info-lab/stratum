# The chain replays from genesis.
$ derive --foundation foundations/F7 --goal '(call ChainHeight (call ReplayFromGenesis (call ChainAuthority) (call GoodChain (grammar lambda) (file "languages/lambda/lambda.generated.meta"))))'
