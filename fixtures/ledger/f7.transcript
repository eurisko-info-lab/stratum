# Publishing an unaccepted repository head is rejected.
$ derive --foundation foundations/F7 --goal '(call ChainRejection (call ReplayFromGenesis (call ChainAuthority) (call UnacceptedChain (grammar lambda))))'
> unaccepted-repository-head

# A local branch is created from a finalized checkpoint.
$ derive --foundation foundations/F7 --goal '(prim tag (call BranchFromCheckpoint (call ReplayFromGenesis (call ChainAuthority) (call GoodChain (grammar lambda) (file "languages/lambda/lambda.generated.meta"))) (q language) (call EmptyRepository) (q main)))'
> checkout
