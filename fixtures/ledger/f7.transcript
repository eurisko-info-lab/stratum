# A broken predecessor link is rejected.
$ derive --foundation foundations/F7 --goal '(call ChainRejection (call ReplayFromGenesis (call ChainAuthority) (call BrokenChain (grammar lambda) (file "languages/lambda/lambda.generated.meta"))))'
> broken-predecessor-link

# An unentitled publisher is rejected.
$ derive --foundation foundations/F7 --goal '(call ChainRejection (call ReplayFromGenesis (call ChainAuthority) (call ForgedChain (grammar lambda))))'
> unentitled-author

# An altered transaction fails signature verification.
$ derive --foundation foundations/F7 --goal '(call ChainRejection (call ReplayFromGenesis (call ChainAuthority) (call TamperedChain (grammar lambda) (file "languages/lambda/lambda.generated.meta"))))'
