module text
record TextFile [text]
judgment ParseText [grammar source] = call Parse [grammar source]
judgment PrintText [grammar syntax] = call Print [grammar syntax]
judgment TextWellFormed [grammar source] =
  match call ParseText [grammar source] {
    case (#TextFile text) -> mk #valid [prim #slen [text]]
    case _ -> mk #invalid [#parse]
  }
