grammar "meta"
start program

token ident sym "[A-Za-z_][A-Za-z0-9_']*"
token symlit sym "#[A-Za-z_][A-Za-z0-9_'>-]*"
token number nat "[0-9]+"
token text str "\"[^\"]*\""
skip ";[^\n]*"

category program
  fold Seq decl

category decl
  prod Module "module" name : ident
  prod Import "import" name : ident
  prod Capability "capability" name : symlit
  prod Evidence "evidence" name : symlit
  prod Mode "mode" name : ident modes : params
  prod Measure "measure" name : ident "=" body : expr
  prod Data "data" name : ident "=" variants : variants
  prod Record "record" name : ident fields : params
  prod JudgmentRules "judgment" name : ident params : params rules : rules
  prod JudgmentBody "judgment" name : ident params : params "=" body : expr

category variants
  fold Variants variant

category variant
  prod Variant "|" name : symlit fields : params

category params
  prod NoParams "[" "]"
  prod Params "[" names : idents "]"

category idents
  fold Idents ident

category rules
  fold Rules rule

category rule
  prod Rule "rule" pattern : pattern "->" body : expr

category expr
  prod Match "match" scrutinee : expr "{" cases : cases "}"
  prod If "if" condition : expr "then" consequent : expr "else" alternative : expr
  prod Let "let" name : ident "=" value : expr "in" body : expr
  prod Fail "fail" kind : symlit message : expr
  pass application

category cases
  fold Cases case

category case
  prod Case "case" pattern : pattern "->" body : expr

category application
  prod Mk "mk" tag : symlit arguments : exprs
  prod Call "call" name : ident arguments : exprs
  prod Prim "prim" name : symlit arguments : exprs
  prod Cap "cap" name : symlit arguments : exprs
  prod ListOf "list" items : exprs
  prod MapOf "map" items : exprs
  pass atom

category exprs
  prod NoExprs "[" "]"
  prod Exprs "[" items : exprseq "]"

category exprseq
  fold ExprSeq expr

category atom
  prod Negative "-" value : number
  prod True "true"
  prod False "false"
  prod Unit "unit"
  prod Symbol value : symlit
  prod Natural value : number
  prod Text value : text
  prod Var name : ident
  paren "(" expr ")"

category pattern
  prod PatCons head : patatom "::" tail : pattern
  pass patatom

category patatom
  prod PatNode "(" tag : symlit arguments : patseq ")"
  prod PatNodeEmpty "(" tag : symlit ")"
  prod PatNil "[" "]"
  prod PatList "[" items : patseq "]"
  prod PatWild "_"
  prod PatSymbol value : symlit
  prod PatNatural value : number
  prod PatText value : text
  prod PatVar name : ident
  paren "(" pattern ")"

category patseq
  fold PatSeq patatom
