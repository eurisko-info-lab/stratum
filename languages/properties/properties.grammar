grammar "properties"
start file

token key sym "[A-Za-z][A-Za-z0-9_.-]*"
token value str "[^\\r\\n= \\t]([^\\r\\n=]*[^\\r\\n= \\t])?"
token newline sym "\\n"
skip "[#!][^\\n]*"

category file
  fold PropertiesFile line

category line
  prod Property key : key "=" value : value newline : newline
  prod Blank newline : newline
