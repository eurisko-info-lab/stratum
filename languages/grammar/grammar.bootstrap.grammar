; Grammar0 declaration of Grammar, the surface language for grammars.
; Grammar elaborates to canonical Grammar0.
(grammar
  (name "grammar")
  (start unit)

  (token ident sym "[A-Za-z_][A-Za-z0-9_']*")
  (token text str "\"([^\"\\\\]|\\\\.)*\"")

  (category unit
    (fold Seq declaration))

  (category declaration
    (prod GrammarName [(kw "grammar") (bind name text)])
    (prod Start [(kw "start") (bind name ident)])
    (prod Token [(kw "token") (bind name ident) (bind kind ident) (bind pattern text)])
    (prod Skip [(kw "skip") (bind pattern text)])
    (prod Category [(kw "category") (bind name ident) (bind productions productions)]))

  (category productions
    (fold Productions production))

  (category production
    (prod Production [(kw "prod") (bind tag ident) (bind elements elements)])
    (prod Pass [(kw "pass") (bind target ident)])
    (prod Fold [(kw "fold") (bind tag ident) (bind target ident)])
    (prod Paren [(kw "paren") (bind open text) (bind target ident) (bind close text)]))

  (category elements
    (fold Elements element))

  (category element
    (prod Keyword [(bind text text)])
    (prod Binding [(bind field ident) (kw ":") (bind target ident)])))
