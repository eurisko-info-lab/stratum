  (judgment
    LeanTypeErrors
    [typed]
    (match
      (v typed)
      (case (pnil) (lst))
      (case
        (pcons
          (pm
            type
            (pv name)
            (pv declared)
            (pq declared)
            (pv inferred))
          (pv rest))
        (if
          (call
            LeanCompatibleType
            (v declared)
            (v inferred))
          (call
            LeanTypeErrors
            (v rest))
          (prim
            cons
            (mk
              type-error
              (v name)
