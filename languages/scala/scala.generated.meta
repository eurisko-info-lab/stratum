          (pcons
            (pm
              Word
              (pv name))
            (pv rest)))
        (let
          own
          (mk
            typed
            (v name)
            (q function))
          (prim
            cons
            (mk
              type
              (v name)
              (q function)
              (q declared)
              (q function))
            (call
              ScalaInferItems
              (v rest)
              (prim
                snoc
                (v env)
                (v own))))))
      (case
        (pcons
          (pv head)
          (pv rest))
        (call
          ScalaInferItems
          (v rest)
          (v env)))))
  (judgment
    ScalaTypeErrors
    [typed]
    (match
      (v typed)
      (case (pnil) (lst))
      (case
        (pcons
          (pm
            type
            (pv name)
            (pv declared)
            (pq declared)
            (pv inferred))
          (pv rest))
        (if
          (call
            ScalaCompatibleType
            (v declared)
            (v inferred))
          (call
            ScalaTypeErrors
            (v rest))
          (prim
            cons
            (mk
              type-error
              (v name)
              (v declared)
              (v inferred))
            (call
              ScalaTypeErrors
              (v rest)))))
      (case
        (pcons
          (pv head)
          (pv rest))
        (call
          ScalaTypeErrors
          (v rest)))))
  (judgment
    InferScala
    [grammar source]
    (call
      ScalaInferItems
      (call
        ScalaBody
        (call
          ParseScala
          (v grammar)
          (v source)))
      (lst)))
  (judgment
    TypeCheckScala
    [grammar source]
    (call
      ScalaTypeErrors
      (call
        InferScala
        (v grammar)
        (v source)))))
