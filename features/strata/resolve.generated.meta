          (v declared)
          (call
            FreeInType
            (v ftype)
            (v declared)
            (v found))))
      (case
        (pcons
          (pv head)
          (pv rest))
        (call
          FreeInFields
          (v rest)
          (v declared)
          (v found)))))
  (judgment
    FreeInType
    [node declared found]
    (match
      (v node)
      (case
        (pm
          TypeRef
          (pv name))
        (call
          NoteFree
          (v name)
          (v declared)
          (v found)))
      (case
        (pm
          TypeApply
          (pv left)
          (pv right))
        (call
          FreeInType
          (v right)
          (v declared)
          (call
            FreeInType
            (v left)
            (v declared)
            (v found))))
      (case
        (pm
          TypeArrow
          (pv from)
          (pv to))
        (call
          FreeInType
          (v to)
          (v declared)
          (call
            FreeInType
            (v from)
            (v declared)
            (v found))))
      (case
        (pm
          TypeDepend
          (pv params)
          (pv to))
        (call
          FreeInType
          (v to)
          (prim
            append
            (v declared)
            (call
              ParamNamesOf
              (call
                ParameterList
                (v params))))
          (call
            FreeInParams
            (call
              ParameterList
              (v params))
            (v declared)
            (v found))))
      (case
        _
        (v found))))
  (judgment
    FreeInExpr
    [node declared found]
    (match
      (v node)
      (case
        (pm
          Var
          (pv name))
        (call
          NoteFree
          (v name)
          (v declared)
          (v found)))
      (case
        (pm
          Apply
          (pv fn)
          (pv argument))
        (call
          FreeInExpr
          (v argument)
          (v declared)
          (call
            FreeInExpr
            (v fn)
            (v declared)
            (v found))))
      (case
        (pm
          Let
          (pv name)
          (pv value)
          (pv body))
        (call
          FreeInExpr
          (v body)
          (prim
            snoc
            (v declared)
            (v name))
          (call
            FreeInExpr
            (v value)
            (v declared)
            (v found))))
      (case
        (pm
          Match
          (pv scrutinee)
          (pv cases))
        (call
          FreeInCases
          (call
            CaseList
            (v cases))
          (v declared)
          (call
            FreeInExpr
            (v scrutinee)
            (v declared)
            (v found))))
      (case
        _
        (v found))))
  (judgment
    FreeInCases
    [cases declared found]
    (match
      (v cases)
      (case
        (pnil)
        (v found))
      (case
        (pcons
          (pm
            Case
            (pv pattern)
            (pv body))
          (pv rest))
        (call
          FreeInCases
          (v rest)
          (v declared)
          (call
            FreeInExpr
            (v body)
            (prim
              append
              (v declared)
              (call
                PatternNamesOf
                (v pattern)))
            (v found))))
      (case
        (pcons
          (pv head)
          (pv rest))
        (call
          FreeInCases
          (v rest)
          (v declared)
          (v found)))))
  (judgment
    PatternNamesOf
    [pattern]
    (match
      (v pattern)
      (case
        (pm
          PatVar
          (pv name))
        (lst
          (v name)))
      (case
        (pm PatWild)
        (lst))
      (case
        (pm
          PatApply
          (pv left)
          (pv right))
        (prim
          append
          (call
            PatternNamesOf
            (v left))
          (call
            PatternNamesOf
            (v right))))
      (case _ (lst))))
  (judgment
    NoteFree
    [name declared found]
    (if
      (prim
        eq
        (v name)
        (q Type))
      (v found)
      (if
        (prim
          contains
          (v declared)
          (v name))
        (v found)
        (prim
          snoc
          (v found)
          (v name)))))
  (judgment
    LinkModule
    [modules name]
    (match
      (call
        VersionsAgree
        (v modules))
      (case
        _
        (match
          (call
            ImportOrder
            (v modules))
          (case
            _
            (call
              GatherDeclarations
              (v modules)
              (call
                NeededModules
                (v modules)
                (v name)
                (lst))
              (lst)))))))
  (judgment
    NeededModules
    [modules name found]
    (if
      (prim
        contains
        (v found)
        (v name))
      (v found)
      (call
        NeededImports
        (v modules)
        (call
          ModuleImports
          (call
            RequiredModule
            (v modules)
            (v name)))
        (prim
          snoc
          (v found)
          (v name)))))
  (judgment
    NeededImports
    [modules needs found]
    (match
      (v needs)
      (case
        (pnil)
        (v found))
      (case
        (pcons
          (pm
            needs
            (pv required)
            (pv version))
          (pv rest))
        (call
          NeededImports
          (v modules)
          (v rest)
          (call
            NeededModules
            (v modules)
            (v required)
            (v found))))
      (case
        (pcons
          (pv head)
          (pv rest))
        (call
          NeededImports
          (v modules)
          (v rest)
          (v found)))))
  (judgment
    GatherDeclarations
    [modules names gathered]
    (match
      (v names)
      (case
        (pnil)
        (v gathered))
      (case
        (pcons
          (pv name)
          (pv rest))
        (call
          GatherDeclarations
          (v modules)
          (v rest)
          (prim
            append
            (call
              UsableDeclarations
              (call
                ModuleDeclarations
                (call
                  RequiredModule
                  (v modules)
                  (v name))))
            (v gathered))))))
  (judgment
    UsableDeclarations
    [decls]
    (match
      (v decls)
      (case (pnil) (lst))
      (case
        (pcons
          (pm
            import
            (pv name)
            (pv version))
          (pv rest))
        (call
          UsableDeclarations
          (v rest)))
      (case
        (pcons
          (pm
            export
            (pv names))
          (pv rest))
        (call
          UsableDeclarations
          (v rest)))
      (case
        (pcons
          (pv head)
          (pv rest))
        (prim
          cons
          (v head)
          (call
            UsableDeclarations
            (v rest))))))
  (judgment
    CheckLinkedModule
    [grammar sources name]
    (call
      CheckDeclarations
      (call
        LinkModule
        (call
          LoadModuleSet
          (v grammar)
          (v sources))
        (v name))
      (call
        ConstructorTable
        (call
          LinkModule
          (call
            LoadModuleSet
            (v grammar)
            (v sources))
          (v name)))
      (call
        DefinitionTable
        (call
          LinkModule
          (call
            LoadModuleSet
