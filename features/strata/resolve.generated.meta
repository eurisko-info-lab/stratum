      TerminationOfDeclarations
      (call
        LinkModule
        (call
          LoadModuleSet
          (v grammar)
          (v sources))
        (v name))))
  (judgment
    ResolutionIsConfluent
    [grammar sources name]
    (prim
      eq
      (call
        ResolveModule
        (call
          LoadModuleSet
          (v grammar)
          (v sources))
        (v name))
      (call
        ResolveModule
        (call
          LoadModuleSet
          (v grammar)
          (prim
            rev
            (v sources)))
        (v name))))
  (judgment
    LinkingIsConfluent
    [grammar sources name]
    (prim
      eq
      (call
        LinkModule
        (call
          LoadModuleSet
          (v grammar)
          (v sources))
        (v name))
      (call
        LinkModule
        (call
          LoadModuleSet
          (v grammar)
          (prim
            rev
            (v sources)))
        (v name)))))
