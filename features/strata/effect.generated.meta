      (case _ (lst))))
  (judgment
    EraseArguments
    [positions dropped args depth drops position]
    (match
      (v args)
      (case (pnil) (lst))
      (case
        (pcons
          (pv argument)
          (pv rest))
        (if
          (prim
            contains
            (v drops)
            (v position))
          (call
            EraseArguments
            (v positions)
            (v dropped)
            (v rest)
            (v depth)
            (v drops)
            (prim
              add
              (v position)
              (q 1)))
          (prim
            cons
            (call
              EraseCore
              (v positions)
              (v dropped)
              (v argument)
              (v depth))
            (call
              EraseArguments
              (v positions)
              (v dropped)
              (v rest)
              (v depth)
              (v drops)
              (prim
                add
                (v position)
                (q 1))))))))
  (judgment
    RebuildApplication
    [head args]
    (match
      (v args)
      (case
        (pnil)
        (v head))
      (case
        (pcons
          (pv argument)
          (pv rest))
        (call
          RebuildApplication
          (prim
            node
            (q CApp)
            (lst
              (v head)
              (v argument)))
          (v rest)))))
  (judgment
    EffectDeclarations
    [grammar sources name]
    (call
      LinkModule
      (call
        LoadModuleSet
        (v grammar)
        (v sources))
      (v name)))
  (judgment
    CheckLinkedCapabilities
    [grammar sources name]
    (call
      CheckCapabilities
      (call
        EffectDeclarations
        (v grammar)
        (v sources)
        (v name))))
  (judgment
    CheckLinkedMultiplicities
    [grammar sources name]
    (call
      CheckMultiplicities
      (call
        EffectDeclarations
        (v grammar)
        (v sources)
        (v name))))
  (judgment
    ErasedProgramOf
    [grammar sources name]
    (let
      decls
      (call
        EffectDeclarations
        (v grammar)
        (v sources)
        (v name))
      (call
        EraseProgram
        (call
          ErasedPositions
          (v decls))
        (call
          ReadProgram
          (v decls)))))
  (judgment
    ErasedArities
    [grammar sources name]
    (call
      ArityList
      (call
        ErasedProgramOf
        (v grammar)
        (v sources)
        (v name))))
  (judgment
    ArityList
    [program]
    (match
      (v program)
      (case
        (pm NoDef)
        (lst))
      (case
        (pm
          Def
          (pv arity)
          (pv body)
          (pv rest))
        (prim
          cons
          (call
            NatOf
            (v arity))
          (call
            ArityList
            (v rest))))
      (case
        _
        (fail
          erase-error
          (q "malformed program")))))
  (judgment
    RunErased
    [grammar compilerSources sources name entry]
    (let
      compiler
      (call
        CompilerDeclarations
        (v grammar)
        (v compilerSources))
      (let
        decls
        (call
          EffectDeclarations
          (v grammar)
          (v sources)
          (v name))
        (let
          program
          (call
            EraseProgram
            (call
              ErasedPositions
              (v decls))
            (call
              ReadProgram
              (v decls)))
          (let
            tags
            (call
              ConstructorTags
              (v decls))
            (call
              FromMachineValue
              (call
                TagNames
                (v tags))
              (call
                RunBlock
                (call
                  BlockList
                  (call
                    CompileProgramWith
                    (v compiler)
                    (v program)))
                (call
                  ArityList
                  (v program))
                (call
                  IndexOfGlobal
                  (call
                    GlobalIndexes
                    (v decls))
                  (v entry))
                (lst))))))))
  (judgment
    ErasurePreservesMeaning
    [grammar compilerSources sources name entry]
    (prim
      eq
      (call
        RunErased
        (v grammar)
        (v compilerSources)
        (v sources)
        (v name)
        (v entry))
      (call
        RunEvaluated
        (v grammar)
        (v sources)
        (v name)
        (v entry)))))
