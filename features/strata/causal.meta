module stratacausal

; History as a causal graph.
;
; This layer adds no primitive and widens nothing. Acceptance, frontiers and
; convergence are Strata's own -- `strata/system/causal.strata` -- and the
; only thing Meta contributes is the source list the checks link.

judgment StrataCausalSystem [prelude native octets artifact collections causal] =
  list [prelude native octets artifact collections causal]
