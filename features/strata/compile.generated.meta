            scat
            (q "the module declares no definition named ")
            (prim
              sym->str
              (v name)))))))
  (judgment
    LinkedDeclarations
    [grammar sources name]
    (call
      LinkModule
      (call
        LoadModuleSet
        (v grammar)
        (v sources))
      (v name)))
  (judgment
    CompileProgramWith
    [compiler program]
    (call
      EnterDefinition
      (v compiler)
      (call
        RequiredDefinition
        (v compiler)
        (q compile))
      (lst
        (v program))))
  (judgment
    RequiredDefinition
    [decls name]
    (match
      (call
        FindDefinition
        (v decls)
        (v name))
      (case
        (pm
          some
          (pv found))
        (v found))
      (case
        _
        (fail
          compile-error
          (prim
            scat
            (q "the module declares no definition named ")
            (prim
              sym->str
              (v name)))))))
  (judgment
    RunBlocksOn
    [decls compiled entry arguments]
    (let
      tags
      (call
        ConstructorTags
        (v decls))
      (call
        FromMachineValue
        (call
          TagNames
          (v tags))
        (call
          RunBlock
          (call
            BlockList
            (v compiled))
          (call
            GlobalArities
            (v decls))
          (call
            IndexOfGlobal
            (call
              GlobalIndexes
              (v decls))
            (v entry))
          (call
            ToMachineArgs
            (v tags)
            (v arguments))))))
  (judgment
    CompilerDeclarations
    [grammar sources]
    (call
      LinkedDeclarations
      (v grammar)
      (v sources)
      (q "strata.compiler")))
  (judgment
    CompilerBlocks
    [grammar sources]
    (let
      compiler
      (call
        CompilerDeclarations
        (v grammar)
        (v sources))
      (call
        CompileProgramWith
        (v compiler)
        (call
          ReadProgram
          (v compiler)))))
  (judgment
    BootstrapDigest
    [grammar sources]
    (prim
      ref->str
      (prim
        digest
        (call
          CompilerBlocks
          (v grammar)
          (v sources)))))
  (judgment
    BootstrapIsStable
    [grammar sources]
    (let
      compiler
      (call
        CompilerDeclarations
        (v grammar)
        (v sources))
      (let
        program
        (call
          ReadProgram
          (v compiler))
        (let
          first
          (call
            CompileProgramWith
            (v compiler)
            (v program))
          (prim
            eq
            (v first)
            (call
              RunBlocksOn
              (v compiler)
              (v first)
              (q compile)
              (lst
                (v program))))))))
  (judgment
    RunCompiled
    [grammar compilerSources sources name entry]
    (let
      compiler
      (call
        CompilerDeclarations
        (v grammar)
        (v compilerSources))
      (let
        decls
        (call
          LinkedDeclarations
          (v grammar)
          (v sources)
          (v name))
        (call
          RunBlocksOn
          (v decls)
          (call
            CompileProgramWith
            (v compiler)
            (call
              ReadProgram
              (v decls)))
          (v entry)
          (lst)))))
  (judgment
    RunEvaluated
    [grammar sources name entry]
    (let
      decls
      (call
        LinkedDeclarations
        (v grammar)
        (v sources)
        (v name))
      (call
        EnterDefinition
        (v decls)
        (call
          RequiredDefinition
          (v decls)
          (v entry))
        (lst))))
  (judgment
    CompilingPreservesMeaning
    [grammar compilerSources sources name entry]
    (prim
      eq
      (call
        RunCompiled
        (v grammar)
        (v compilerSources)
        (v sources)
        (v name)
        (v entry))
      (call
        RunEvaluated
        (v grammar)
        (v sources)
        (v name)
        (v entry)))))
