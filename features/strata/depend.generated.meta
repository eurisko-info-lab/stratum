        (fail
          type-error
          (q "applied a value that is not a function")))))
  (judgment
    ArgumentAsType
    [argument]
    (match
      (v argument)
      (case
        (pm
          Var
          (pv name))
        (mk
          con
          (v name)))
      (case
        (pm
          Apply
          (pv left)
          (pv right))
        (mk
          apply
          (call
            ArgumentAsType
            (v left))
          (call
            ArgumentAsType
            (v right))))
      (case
        _
        (mk
          con
          (q opaque)))))
  (judgment
    RewriteAlong
    [ctors defs proofType type]
    (match
      (call
        TypeSpine
        (v proofType))
      (case
        (pcons
          (pm
            con
            (pv family))
          (pv args))
        (match
          (v args)
          (case
            (pcons
              (pv carrier)
              (pcons
                (pv from)
                (pcons
                  (pv to)
                  (pnil))))
            (call
              NormalizeType
              (v ctors)
              (v defs)
              (call
                RewriteOccurrences
                (v from)
                (v to)
                (v type))))
          (case
            _
            (fail
              type-error
              (q "a proof of equality carries a type and two sides")))))
      (case
        _
        (fail
          type-error
          (q "a proof of equality carries a type and two sides")))))
  (judgment
    RewriteOccurrences
    [from to type]
    (if
      (prim
        eq
        (v type)
        (v from))
      (v to)
      (match
        (v type)
        (case
          (pm
            apply
            (pv left)
            (pv right))
          (mk
            apply
            (call
              RewriteOccurrences
              (v from)
              (v to)
              (v left))
            (call
              RewriteOccurrences
              (v from)
              (v to)
              (v right))))
        (case
          (pm
            arrow
            (pv a)
            (pv b))
          (mk
            arrow
            (call
              RewriteOccurrences
              (v from)
              (v to)
              (v a))
            (call
              RewriteOccurrences
              (v from)
              (v to)
              (v b))))
        (case
          (pm
            depend
            (pv bound)
            (pv a)
            (pv b))
          (mk
            depend
            (v bound)
            (call
              RewriteOccurrences
              (v from)
              (v to)
              (v a))
            (call
              RewriteOccurrences
              (v from)
              (v to)
              (v b))))
        (case
          _
          (v type))))))
