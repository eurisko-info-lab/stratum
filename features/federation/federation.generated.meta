    [first second third]
    (lst
      (mk
        step
        (call
          FirstProposal
          (v first)
          (v second))
        (call
          CertificateFor
          (call
            SecondProposal
            (v second)
            (v third))
          (call Quorum)))))
  (judgment
    SettleWrongCertificate
    [first second third]
    (call
      ReplayFinalizedHistory
      (call Federation)
      (call
        WrongCertificateHistory
        (v first)
        (v second)
        (v third))
      (call InitialFederationState)))
  (judgment
    WrongFederationHistory
    [first second]
    (lst
      (mk
        step
        (call
          FirstProposal
          (v first)
          (v second))
        (call
          CertificateFor
          (call
            FirstProposal
            (v first)
            (v second))
          (call Quorum)))))
  (judgment
    SettleWrongFederation
    [first second]
    (call
      ReplayFinalizedHistory
      (call OtherFederation)
      (call
        WrongFederationHistory
        (v first)
        (v second))
      (call InitialFederationState)))
  (judgment
    SemanticallyInvalidVote
    [first second]
    (call
      CastVote
      (call
        ReplicaSecret
        (q "a"))
      (call Federation)
      (call
        MakeProposal
        (call
          ReplicaSecret
          (q "a"))
        (q stratum)
        (q 1)
        (q 1)
        (v second)
        (v first))))
  (judgment
    DoubleVote
    [first second third]
    (call
      DetectEquivocation
      (lst
        (call
          VoteOn
          (q "a")
          (call
            FirstProposal
            (v first)
            (v second)))
        (call
          VoteOn
          (q "a")
          (call
            ProposalAt
            (q 1)
            (v second)
            (v third))))))
  (judgment
    HonestVotes
    [first second]
    (call
      DetectEquivocation
      (call
        VotesFrom
        (call Quorum)
        (call
          FirstProposal
          (v first)
          (v second)))))
  (judgment
    MembershipAfterSettlement
    [first second third]
    (prim
      len
      (call
        ReplicaSet'members
        (match
          (call
            ChangeMembership
            (call Federation)
            (lst
              (call
                ReplicaKey
                (q "e")))
            (call
              SettleTwo
              (v first)
              (v second)
              (v third)))
          (case
            (pm
              members
              (pv updated))
            (v updated))
          (case
            (pm
              blocked
              (pv reason))
            (call Federation)))))))
