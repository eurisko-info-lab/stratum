      (v stages)
      (case (pnil) (lst))
      (case
        (pcons
          (pv head)
          (pv rest))
        (prim
          cons
          (mk
            stage
            (v head)
            (call
              RunStage
              (v head)
              (v grammar)))
          (call
            RunRoundTrip
            (v rest)
            (v grammar))))))
  (judgment
    WorkflowRoundTrip
    [grammar]
    (call
      RunRoundTrip
      (call RoundTripStages)
      (v grammar)))
  (judgment
    RoundTripStageCount
    [grammar]
    (prim
      len
      (call
        WorkflowRoundTrip
        (v grammar))))
  (judgment
    RoundTripStageNames
    []
    (call RoundTripStages))
  (judgment
    StageResult
    [grammar stage]
    (call
      RunStage
      (v stage)
      (v grammar))))
