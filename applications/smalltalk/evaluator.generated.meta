      (v parts)
      (case
        (pnil)
        (mk
          signature
          (prim
            str->sym
            (v name))
          (v parameters)))
      (case
        _
        (match
          (prim
            head
            (v parts))
          (case
            (pm
              PatternPart
              (pv selector)
              (pv parameter))
            (call
              KeywordSignature
              (prim
                tail
                (v parts))
              (prim
                scat
                (v name)
                (prim
                  sym->str
                  (v selector)))
              (prim
                snoc
                (v parameters)
                (v parameter))))
          (case
            _
            (call
              KeywordSignature
              (prim
                tail
                (v parts))
              (v name)
              (v parameters)))))))
  (judgment
    PatternSignature
    [pattern]
    (match
      (v pattern)
      (case
        (pm
          UnaryPattern
          (pv selector))
        (mk
          signature
          (v selector)
          (lst)))
      (case
        (pm
          BinaryPattern
          (pv selector)
          (pv parameter))
        (mk
          signature
          (v selector)
          (lst
            (v parameter))))
      (case
        (pm
          KeywordPattern
          (pv parts))
        (call
          KeywordSignature
          (call
            FlattenPatternParts
            (v parts))
          (q "")
          (lst)))
      (case
        _
        (mk
          signature
          (q yourself)
          (lst)))))
  (judgment
    ClassDefinition
    [statement]
    (match
      (v statement)
      (case
        (pm
          Evaluate
          (pv expression))
        (call
          ClassDefinitionOf
          (v expression)))
      (case
        (pm
          EvaluateFinal
          (pv expression))
        (call
          ClassDefinitionOf
          (v expression)))
      (case
        _
        (mk no))))
  (judgment
    ClassDefinitionOf
    [expression]
    (match
      (v expression)
      (case
        (pm
          KeywordSend
          (pv receiver)
          (pv arguments))
        (let
          parts
          (call
            FlattenArguments
            (v arguments))
          (if
            (prim
              eq
              (call
                KeywordSelector
                (v parts)
                (q ""))
              (prim
                str->sym
                (q "subclass:instanceVariableNames:")))
            (call
              ClassDefinitionParts
              (v receiver)
              (v parts))
            (mk no))))
      (case
        _
        (mk no))))
  (judgment
    ClassDefinitionParts
    [receiver parts]
    (match
      (v receiver)
      (case
        (pm
          Variable
          (pv superclass))
        (match
          (prim
            nth
            (v parts)
            (q 0))
          (case
            (pm
              KeywordArgument
              (pv selector)
              (pv argument))
            (match
              (v argument)
              (case
                (pm
                  Symbol
                  (pv name))
                (match
                  (prim
                    nth
                    (v parts)
                    (q 1))
                  (case
                    (pm
                      KeywordArgument
                      (pv other)
                      (pv slots))
                    (match
                      (v slots)
                      (case
                        (pm
                          Text
                          (pv text))
                        (mk
                          class-definition
                          (call
                            SymbolName
                            (v name))
                          (v superclass)
                          (call
                            SplitNames
                            (call
                              Unquoted
                              (v text)))))
                      (case
                        _
                        (mk no))))
                  (case
                    _
                    (mk no))))
              (case
                _
                (mk no))))
          (case
            _
            (mk no))))
      (case
        _
        (mk no))))
  (judgment
    LoadChunks
    [image chunks statements]
    (match
      (v chunks)
      (case
        (pnil)
        (mk
          loaded
          (v image)
          (v statements)))
      (case
        _
        (call
          LoadChunk
          (v image)
          (prim
            head
            (v chunks))
          (prim
            tail
            (v chunks))
          (v statements)))))
  (judgment
    LoadChunk
    [image chunk rest statements]
    (match
      (v chunk)
      (case
        (pm
          MethodWithTemporaries
          (pv holder)
          (pv pattern)
          (pv temporaries)
          (pv body))
        (match
          (call
            PatternSignature
            (v pattern))
          (case
            (pm
              signature
              (pv selector)
              (pv parameters))
            (call
              LoadChunks
              (call
                DefineMethod
                (v image)
                (v holder)
                (v selector)
                (mk
                  method
                  (prim
                    append
                    (v parameters)
                    (call
                      TemporaryNames
                      (v temporaries)))
                  (v body)
                  (v chunk)))
              (v rest)
              (v statements)))))
      (case
        (pm
          Method
          (pv holder)
          (pv pattern)
          (pv body))
        (match
          (call
            PatternSignature
            (v pattern))
          (case
            (pm
              signature
              (pv selector)
              (pv parameters))
            (call
              LoadChunks
              (call
                DefineMethod
                (v image)
                (v holder)
                (v selector)
                (mk
                  method
                  (v parameters)
                  (v body)
                  (v chunk)))
              (v rest)
              (v statements)))))
      (case
        _
        (match
          (call
            ClassDefinition
            (v chunk))
          (case
            (pm
              class-definition
              (pv name)
              (pv superclass)
              (pv slots))
            (call
              LoadChunks
              (call
                DefineClass
                (v image)
                (v name)
                (v superclass)
                (v slots))
              (v rest)
              (v statements)))
          (case
            _
            (call
              LoadChunks
              (v image)
              (v rest)
              (prim
                snoc
                (v statements)
                (v chunk))))))))
  (judgment
    RunUnit
    [tree]
    (call
      RunWithImage
      (call EmptyImage)
      (v tree)))
  (judgment
    RunWithImage
    [base tree]
    (match
      (call
        LoadChunks
        (v base)
        (call
          FlattenChunks
          (v tree))
        (lst))
      (case
        (pm
          loaded
          (pv image)
          (pv statements))
        (match
          (call
            NewFrame
            (call EmptyHeap)
            (prim
              mput
              (prim mnew)
              (q self)
              (call Nil))
            (call Nil))
          (case
            (pm
              framed
              (pv frame)
              (pv heap))
            (match
              (call
                EvalStatements
                (v image)
                (v heap)
                (v frame)
                (v statements))
              (case
                (pm
                  normal
                  (pv value)
                  (pv finalHeap))
                (mk
                  value
                  (call
                    PrintValue
                    (call
                      NonLocalValue
                      (v value)))))
              (case
                (pm
                  returned
                  (pv value)
                  (pv finalHeap))
                (mk
                  value
                  (call
                    PrintValue
                    (call
                      NonLocalValue
                      (v value)))))))))))
  (judgment
    EvalSource
    [grammar source]
    (match
      (cap
        grammar-parse
        (v grammar)
        (v source))
      (case
        (pm
          ok
          (pv tree))
        (call
          RunUnit
          (v tree)))
      (case
        (pm
          denied
          (pv reason))
        (mk
          rejected
          (v reason)))))
  (judgment
    EvalInImage
    [grammar base source]
    (match
      (cap
        grammar-parse
        (v grammar)
        (v source))
      (case
        (pm
          ok
          (pv tree))
        (call
          RunWithImage
          (v base)
          (v tree)))
      (case
        (pm
          denied
          (pv reason))
        (mk
          rejected
          (v reason))))))
