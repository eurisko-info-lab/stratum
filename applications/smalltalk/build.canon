; The Smalltalk deployment, branched from S18.
;
; This is not a step of the bootstrap staircase. It is an application built on
; the finished platform: its predecessor is S18, it reuses S18's Strata runtime,
; change calculus, repository, toolchain, governance, ledger, agreement,
; retention and Studio runtime, and it adds only its own language and profile.
(build
  (name "Smalltalk")
  (bootstrap "StratumHost0/1")
  (predecessor (dir "foundations/S18"))
  (change (file "changes/S18-smalltalk/change.canon"))
  (application
    (application
      (name "smalltalk-deployment")
      (host (file "host/core.canon"))
      (meta (program-of [
        (file "features/strata/index.generated.meta")
        (file "features/strata/optimization.generated.meta")
        (file "languages/meta/prelude.meta")
        (file "languages/meta/source.meta")
        (file "languages/meta/elaborate.meta")
        (file "languages/grammar/elaborate.meta")
        (file "languages/foundation/foundation.meta")
        (file "languages/foundation/derive.meta")
        (file "languages/foundation/delta.meta")
        (file "foundations/S18/surface/strata.generated.meta")
        (file "features/strata/check.generated.meta")
        (file "features/strata/total.generated.meta")
        (file "features/strata/schema.generated.meta")
        (file "features/strata/depend.generated.meta")
        (file "features/strata/change.generated.meta")
        (file "features/strata/law.generated.meta")
        (file "features/strata/application-resolve.generated.meta")
        (file "features/strata/compile.generated.meta")
        (file "features/strata/application.generated.meta")
        (file "languages/lambda/lambda.generated.meta")
        (file "features/change/change.generated.meta")
        (file "features/repository/repository.generated.meta")
        (file "features/repository/scenarios.generated.meta")
        (file "features/tooling/tooling.generated.meta")
        (file "features/governance/governance.generated.meta")
        (file "features/governance/scenarios.generated.meta")
        (file "features/foundation/foundation.generated.meta")
        (file "features/ledger/ledger.generated.meta")
        (file "features/sync/sync.generated.meta")
        (file "features/federation/federation.generated.meta")
        (file "features/retention/retention.generated.meta")
        (file "features/studio/studio.generated.meta")
        (file "languages/service/service.generated.meta")
        (file "applications/smalltalk/evaluator.generated.meta")
        (file "applications/smalltalk/image.generated.meta")
        (file "applications/smalltalk/smalltalk.generated.meta")
        (file "applications/smalltalk/service.generated.meta")
      ]))
      (grammars {
        strata (file "foundations/S18/surface/strata.generated.grammar")
        lambda (file "languages/lambda/lambda.generated.grammar")
        meta (file "languages/meta/meta.generated.grammar")
        grammar (file "languages/grammar/grammar.generated.grammar")
        smalltalk (file "applications/smalltalk/smalltalk.generated.grammar")
      })
      (entries {})
      (documents {
        counter (text-file "applications/smalltalk/documents/counter.st")
      })
      (studios {
        smalltalk-browser (file "applications/smalltalk/profile.canon")
      })
      (service (file "applications/smalltalk/service.canon"))
      (checks (include "applications/smalltalk/checks.canon"))
      (kernel (kernel (allow cas-get cas-has hash grammar-parse grammar-print grammar-lex sign verify public-key
                            send receive open-connection close-connection pending)))
      (resources (budget (steps 1000000000) (depth 240000))))))
