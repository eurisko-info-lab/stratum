; The SDS studio profile, recorded as a canonical artifact.
; The authoritative definition is `SdsProfile` in
; features/studio/studio.meta; this artifact records the selection.
(profile
  (name "sds-editor")
  (language sds)
  (layout document-workflow)
  (navigation document-centric)
  (panels [sections paragraph variants fields mixture findings approval provenance preview])
  (commands [run-validation submit-for-review approve-document export-document])
  (workflow [draft review approve publish])
  (roles [author reviewer])
  (projections [spreadsheet])
  (foreign [json xml pdf]))
