; delta-grammar for S0 -> S1: the Strata surface is unchanged. S1 decides what
; the surface already written down means, and adds nothing to write.
(change
  (kind delta-grammar)
  (name "S0->S1 delta-grammar")
  (replace
    (ReplaceChange
      strata-syntax
      (present [module version data def law match case let end])
      (present [module version data def law match case let end]))))
