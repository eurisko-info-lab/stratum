; delta-grammar for S10 -> S11: the Strata surface is unchanged. A history is
; said with the forms S7 drew and S10 used; deciding what a chain means needed
; nothing new to say it with.
(change
  (kind delta-grammar)
  (name "S10->S11 delta-grammar")
  (replace
    (ReplaceChange
      strata-syntax
      (present [module version data def law match case let end telescope index bind import export uses erased once affine many prim type escape])
      (present [module version data def law match case let end telescope index bind import export uses erased once affine many prim type escape]))))
