; The canonical change from S10 to S11.
;
; S10 |- S11. History becomes Strata's.
(change
  (kind foundation)
  (name "S10->S11")
  (predecessor (foundation-of "foundations/S10"))
  (delta-meta (file "changes/S10-S11/delta-meta.canon"))
  (delta-grammar (file "changes/S10-S11/delta-grammar.canon"))
  (feature
    (feature
      (name "the semantic repository")
      (programs [
        (file "features/strata/index.generated.meta")
        (file "features/strata/store.generated.meta")
        (file "features/strata/repository.generated.meta")
      ])
      (sources [
        (text-file "features/strata/index.meta")
        (text-file "features/strata/store.meta")
        (text-file "features/strata/repository.meta")
        (text-file "strata/system/repository.strata")
      ]))))
