; The canonical change from F9 to F10.
;
; A retention constitution explicitly identifies which judgments must remain
; derivable. Derived and cached artifacts may be discarded when their
; regeneration inputs remain retained.
(change
  (kind foundation)
  (name "F9->F10")
  (predecessor (foundation-of "foundations/F9"))
  (delta-meta (file "changes/F9-F10/delta-meta.canon"))
  (delta-grammar (file "changes/F9-F10/delta-grammar.canon"))
  (feature
    (feature
      (name "constituted semantic retention and archives")
      (programs [(file "features/retention/retention.generated.meta")])
      (sources [(text-file "features/retention/retention.meta")])
      (modes [CurrentStateOnly TransitionMetadata ReplayableFoundation FullSemanticHistory CheckpointedHistory]))))
