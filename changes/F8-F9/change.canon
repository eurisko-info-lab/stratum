; The canonical change from F8 to F9.
;
; The ordering rule is semantic validity before agreement: a replica votes only
; after the proposed transition is valid under the selected foundation. The
; agreement state machine, certificate meaning and transition validity are all
; Meta programs; the host supplies only transport and signature primitives.
(change
  (kind foundation)
  (name "F8->F9")
  (predecessor (foundation-of "foundations/F8"))
  (delta-meta (file "changes/F8-F9/delta-meta.canon"))
  (delta-grammar (file "changes/F8-F9/delta-grammar.canon"))
  (feature
    (feature
      (name "constituted agreement and settlement")
      (programs [(file "features/federation/federation.generated.meta")])
      (sources [(text-file "features/federation/federation.meta")])
      (membership three-f-plus-one))))
