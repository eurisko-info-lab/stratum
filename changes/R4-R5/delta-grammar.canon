; R5 adds no Strata surface. The R4 grammar is inherited exactly: a chunk is
; data, a digest is text, and both were already here.
(change
  (kind delta-grammar)
  (name "R4->R5 delta-grammar")
  (replace
    (ReplaceChange
      second-floor-grammar
      (converging strata)
      (decomposing strata))))
