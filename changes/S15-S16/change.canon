; The canonical change from S15 to S16.
(change
  (kind foundation)
  (name "S15->S16")
  (predecessor (foundation-of "foundations/S15"))
  (delta-meta (file "changes/S15-S16/delta-meta.canon"))
  (delta-grammar (file "changes/S15-S16/delta-grammar.canon"))
  (feature
    (feature
      (name "investigation agents")
      (programs [(file "features/strata/agent.generated.meta")])
      (sources [
        (text-file "features/strata/agent.meta")
        (text-file "strata/system/agent.strata")
      ]))))