; The canonical change from F11 to S0.
;
; F11 |- S0. The first floor is complete, and it constructs the seed of the
; second: a language whose modules are ordinary Stratum artifacts, with a
; surface that prints back byte for byte, a canonical module behind that
; surface, and an evaluator for its core forms.
;
; Strata is described in Meta here, and only here. From S1 onward the
; language describes itself.
(change
  (kind foundation)
  (name "F11->S0")
  (predecessor (foundation-of "foundations/F11"))
  (delta-meta (file "changes/F11-S0/delta-meta.canon"))
  (delta-grammar (file "changes/F11-S0/delta-grammar.canon"))
  (feature
    (feature
      (name "the Strata seed")
      (grammars [(file "languages/strata/strata.generated.grammar")])
      (programs [(file "languages/strata/strata.generated.meta")])
      (sources [
        (text-file "languages/strata/strata.grammar")
        (text-file "languages/strata/strata.meta")
      ]))))
