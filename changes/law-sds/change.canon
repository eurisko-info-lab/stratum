; SDS composes the independently deployed PKI and regulatory catalog.
(change
  (kind application)
  (name "Law->SDS")
  (predecessor (foundation-of "applications/law"))
  (feature
    (feature
      (name "partially confidential multilingual SDS")
      (languages [
        (file "applications/sds/sds.generated.grammar")
        (file "applications/sds/sds-v2.generated.grammar")
        (file "applications/sds/sds-v3.generated.grammar")
      ])
      (programs [
        (file "applications/pki/pki.generated.meta")
        (file "applications/law/law.generated.meta")
        (file "languages/service/service.generated.meta")
        (file "applications/sds/sds.generated.meta")
      ])
      (sources [
        (text-file "applications/pki/pki.meta")
        (text-file "applications/law/law.meta")
        (text-file "applications/sds/sds.grammar")
        (text-file "applications/sds/sds-v2.grammar")
        (text-file "applications/sds/sds-v3.grammar")
        (text-file "applications/sds/sds.meta")
      ])
      (profiles [
        (file "applications/sds/profile-v1.canon")
        (file "applications/sds/profile-v2.canon")
        (file "applications/sds/profile-v3.canon")
      ])
      (services [(file "applications/sds/service.canon")])
      (documents [
        (text-file "applications/sds/documents/acetone-v1.sds")
        (text-file "applications/sds/documents/acetone-v2.sds")
        (text-file "applications/sds/documents/acetone-v3.sds")
      ]))))
