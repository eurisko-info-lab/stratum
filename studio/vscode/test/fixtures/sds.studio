# A VS Code-hosted studio session, replayed against a packaged SDS client.
# The transcript drives editor actions, checks rendered views, and asserts
# which LSP requests the plugin made while doing so.

world "applications/sds";

writeFile {
  path: ".studio-test/acetone.sds",
  text: [
    'document "Acetone"',
    '',
    'section 1 "Identification"',
    '  sentence product "Acetone"',
    '  field boiling-point 65 fahrenheit'
  ]
};

openFile { path: ".studio-test/acetone.sds" };

assertDiagnostics {
  path: ".studio-test/acetone.sds",
  messages: ["unknown-unit: boiling-point"]
};

assertViews {
  entries: ["Sentence product", "Field boiling-point"],
  findings: ["finding unknown-unit"],
  hazards: [],
  preview: [],
  sections: ["Section 1"]
};

assertDocuments [
  {
    name: "Acetone",
    reports: [
      { name: "acetone-v1", path: "applications/sds/documents/acetone-v1.sds", findings: 0, hazards: 0 },
      { name: "acetone-v2", path: "applications/sds/documents/acetone-v2.sds", findings: 0, hazards: 1 }
    ]
  }
];

assertTraceContains ["stratum/views", "stratum/documents", "stratum/pdf"];
clearTrace;
command { id: "stratum.run-validation" };
assertTraceContains ["workspace/executeCommand", "stratum/views", "stratum/documents", "stratum/pdf"];

replaceFile {
  path: ".studio-test/acetone.sds",
  text: [
    'document "Acetone"',
    '',
    'section 1 "Identification"',
    '  sentence product "Acetone"',
    '  field boiling-point 56 celsius'
  ]
};

assertDiagnostics {
  path: ".studio-test/acetone.sds",
  messages: []
};

assertViews {
  entries: ["Sentence product", "Field boiling-point"],
  findings: [],
  hazards: [],
  preview: [],
  sections: ["Section 1"]
};