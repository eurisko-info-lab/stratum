# A VS Code-hosted studio session for the Smalltalk browser.
# The transcript opens the sample document, checks the browser panes the world
# publishes, and verifies both evaluate-selection and run-workspace over the
# real extension host.

world "applications/smalltalk";

openFile { path: "applications/smalltalk/documents/counter.st" };

assertDiagnostics {
  path: "applications/smalltalk/documents/counter.st",
  messages: []
};

assertViewContains {
  classes: ["Stack - 6 methods", "StackNode - 4 methods"],
  selectors: ["Stack >> pop", "StackNode >> value:"],
  method: ["Stack >> initialize [top := nil. size := 0. ^ self]"],
  inspector: ["it = 4"],
  transcript: ["4"]
};

assertDocumentsContain [
  { name: "Counter", reports: ["count", "increment", "initialize"] },
  { name: "counter", reports: ["counter.st"] }
];

assertTraceContains ["stratum/views", "stratum/documents", "stratum/pdf"];
clearTrace;

select {
  start: { line: 58, character: 0 },
  end: { line: 58, character: 46 }
};

command { id: "stratum.evaluate" };
assertOutputContains ["4"];
assertTraceContains ["stratum/evaluate"];

clearTrace;
command { id: "stratum.run-workspace" };
assertTraceContains ["workspace/executeCommand", "stratum/views", "stratum/documents", "stratum/pdf"];